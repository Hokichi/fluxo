<UserControl
    x:Class="Fluxo.Installer.Views.Pages.InstallerFinishedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Fluxo.Installer.Models"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    d:DesignHeight="560"
    d:DesignWidth="860"
    mc:Ignorable="d">
    <UserControl.Resources>
<ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Fonts.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Icons.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Converters.xaml" />

                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/ContainerStyles.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/TextBoxStyles.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/GlobalStyles.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/PopupStyles.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/MainWindowStyles.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/SettingsStyle.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/StepNavigatorStyle.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/QuickSetupWizardStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InstallerFinishedCircleStyle" TargetType="Button"
                   BasedOn="{StaticResource WizardCircleActionButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </Style.Triggers>
            </Style>
<Style BasedOn="{StaticResource InstallerFinishedCircleStyle}" TargetType="Button" x:Key="InstallerFinishedActionButtonStyle">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="{x:Static models:InstallerState.FinishedSuccess}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="{x:Static models:InstallerState.FinishedUpToDate}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
</ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>

            <components:RisingFlowBackground Grid.RowSpan="2" AccentBrush="{DynamicResource Color.Mint}" />

            <StackPanel MaxWidth="600" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border
                    Width="84"
                    Height="84"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Background.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="42">
                    <Image
                        Margin="20"
                        Source="/Fluxo.Resources;component/Resources/fluxo.ico"
                        Stretch="Uniform" />
                </Border>

                <TextBlock
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource Bold}"
                    FontSize="30"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="{Binding FinishedTitle, Mode=OneWay}" />

                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource Medium}"
                    FontSize="13"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    Text="{Binding FinishedSubtitle, Mode=OneWay}" TextWrapping="Wrap"
                    TextAlignment="Center" />

                <StackPanel
                    Margin="0,28,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
<Button AutomationProperties.Name="Launch fluxo" ToolTip="Launch fluxo" Command="{Binding LaunchAppCommand, Mode=OneWay}" Style="{StaticResource InstallerFinishedActionButtonStyle}">

                        <components:Icon
                            Width="14"
                            Height="14"
                            Path="{StaticResource RocketSolid}"
                            Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
                    </Button>

                    <Button
                        Margin="12,0,0,0"
                        Background="{DynamicResource Brush.Background.Hover}"
                        AutomationProperties.Name="Close setup" ToolTip="Close setup" Command="{Binding CloseInstallerCommand, Mode=OneWay}"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Style="{StaticResource InstallerFinishedCircleStyle}">
                        <components:Icon
                            Width="14"
                            Height="14"
                            Path="{StaticResource Close}"
                            Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
                    </Button>
                </StackPanel>

                <TextBlock
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource Medium}"
                    FontSize="11"
                    Foreground="{DynamicResource Brush.Text.Muted}"
                    Text="{Binding StatusMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
