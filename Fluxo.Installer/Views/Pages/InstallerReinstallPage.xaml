<UserControl x:Class="Fluxo.Installer.Views.Pages.InstallerReinstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Fonts.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/ContainerStyles.xaml" />
                <ResourceDictionary Source="/Fluxo.Resources;component/Resources/Styles/ButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ReinstallSurfaceStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReinstallBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource Medium}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReinstallDeclineStyle" TargetType="Button" BasedOn="{StaticResource DialogActionButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsEnabled" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Opacity" Value="0.9" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsPressed" Value="True" />
                            <Condition Property="IsEnabled" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Opacity" Value="0.75" />
                    </MultiTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                            <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReinstallConfirmStyle" TargetType="Button" BasedOn="{StaticResource PrimaryDialogActionButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsEnabled" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Opacity" Value="0.9" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsPressed" Value="True" />
                            <Condition Property="IsEnabled" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Opacity" Value="0.75" />
                    </MultiTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                            <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding DeclineReinstallCommand, Mode=OneWay}" />
    </UserControl.InputBindings>
    <Border Style="{StaticResource ReinstallSurfaceStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="480" Margin="16" VerticalAlignment="Center">
                <TextBlock Text="Reinstall fluxo" FontFamily="{StaticResource Bold}" FontSize="18"
                           Style="{StaticResource ReinstallBodyStyle}" />
                <TextBlock Margin="0,16,0,0" Text="{Binding ReinstallPrompt, Mode=OneWay}"
                           Style="{StaticResource ReinstallBodyStyle}" />
                <TextBlock Margin="0,24,0,8" Text="Installed location" Style="{StaticResource ReinstallBodyStyle}" />
                <TextBlock Text="{Binding InstallFolder, Mode=OneWay}" Style="{StaticResource ReinstallBodyStyle}" />
                <TextBlock Margin="0,16,0,0" Text="Your personal data will be kept."
                           Style="{StaticResource ReinstallBodyStyle}" />
                <Button Margin="0,24,0,8" Content="Yes, reinstall" AutomationProperties.Name="Reinstall fluxo"
                        Command="{Binding ReinstallCommand, Mode=OneWay}" Style="{StaticResource ReinstallConfirmStyle}" />
                <Button x:Name="DeclineButton" Content="No" AutomationProperties.Name="Keep installed version"
                        IsDefault="True" Command="{Binding DeclineReinstallCommand, Mode=OneWay}"
                        Style="{StaticResource ReinstallDeclineStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
