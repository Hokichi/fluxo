<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls">

    <Style x:Key="BaseComboBoxStyle" TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>

    <Style x:Key="BaseComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>

    <Style x:Key="BaseExpanderStyle" TargetType="Expander">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="IsExpanded" Value="True" />
    </Style>

    <Style x:Key="BaseGroupItemStyle" TargetType="GroupItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>

    <Style x:Key="BaseListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="BaseTreeViewItemStyle" TargetType="TreeViewItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsExpanded" Value="True" />
    </Style>

    <Style x:Key="BaseItemsControlStyle" TargetType="ItemsControl" />

    <Style x:Key="BaseListBoxStyle" TargetType="ListBox">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="BaseListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="BaseListViewItemStyle" TargetType="ListViewItem" />

    <Style x:Key="BaseTreeViewStyle" TargetType="TreeView">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="BaseProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>

    <Style x:Key="BaseScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>

    <Style x:Key="BaseScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>

    <Style x:Key="BaseSliderStyle" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="24" />
    </Style>

    <Style x:Key="BaseThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>

    <Style x:Key="BaseToolTipStyle" TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style x:Key="BaseFadingScrollViewerStyle" TargetType="{x:Type customControls:FadingScrollViewer}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Visible" />
        <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    </Style>

    <Style BasedOn="{StaticResource BaseToolTipStyle}" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Brush.BalloonButton.Background.Default}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Medium}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundedHorizontalScrollThumbStyle" BasedOn="{StaticResource BaseThumbStyle}" TargetType="Thumb">
        <Setter Property="Background" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="ThumbBody"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2"
                        Opacity="0.7" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody" Property="Opacity" Value="1" />
                            <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundedVerticalScrollThumbStyle" BasedOn="{StaticResource BaseThumbStyle}" TargetType="Thumb">
        <Setter Property="Background" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Width" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="ThumbBody"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2"
                        Opacity="0.7" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody" Property="Opacity" Value="1" />
                            <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="RoundedVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid x:Name="Root" Background="Transparent">
            <Border
                x:Name="TrackBackground"
                Width="8"
                Margin="2,0"
                HorizontalAlignment="Center"
                Background="{TemplateBinding Background}"
                CornerRadius="4"
                Opacity="0" />
            <Track
                x:Name="PART_Track"
                IsDirectionReversed="True"
                Orientation="Vertical">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.LineUpCommand"
                        IsHitTestVisible="False"
                        Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource RoundedVerticalScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Command="ScrollBar.LineDownCommand"
                        IsHitTestVisible="False"
                        Opacity="0" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger SourceName="PART_Track" Property="IsMouseCaptureWithin" Value="True">
                <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RoundedVerticalScrollBarStyle" BasedOn="{StaticResource BaseScrollBarStyle}" TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Background" Value="{StaticResource Brush.Background.Deepened}" />
        <Setter Property="Template" Value="{StaticResource RoundedVerticalScrollBarTemplate}" />
    </Style>

    <Style BasedOn="{StaticResource BaseScrollBarStyle}" TargetType="ScrollBar">
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Background" Value="{StaticResource Brush.Background.Deepened}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border
                            x:Name="TrackBackground"
                            Height="8"
                            Margin="0,2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Opacity="0" />
                        <Track x:Name="PART_Track" Orientation="Horizontal">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.LineLeftCommand"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource RoundedHorizontalScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.LineRightCommand"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger SourceName="PART_Track" Property="IsMouseCaptureWithin" Value="True">
                            <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="Template" Value="{StaticResource RoundedVerticalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource BaseScrollViewerStyle}" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <ScrollContentPresenter
                            x:Name="PART_ScrollContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            CanHorizontallyScroll="False"
                            CanVerticallyScroll="False"
                            Content="{TemplateBinding Content}" />

                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Margin="0"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="VerticalScrollBar"
                            Cursor="Arrow"
                            IsHitTestVisible="False"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            Opacity="0"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Margin="0"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="HorizontalScrollBar"
                            Cursor="Arrow"
                            IsHitTestVisible="False"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Minimum="0"
                            Opacity="0"
                            Orientation="Horizontal"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_HorizontalScrollBar" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger SourceName="PART_VerticalScrollBar" Property="IsMouseCaptureWithin" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger SourceName="PART_HorizontalScrollBar" Property="IsMouseCaptureWithin" Value="True">
                            <Setter TargetName="PART_HorizontalScrollBar" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BaseFadingScrollViewerStyle}" TargetType="{x:Type customControls:FadingScrollViewer}">
        <Setter Property="Margin" Value="10" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Visible" />
        <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type customControls:FadingScrollViewer}">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <Border x:Name="PART_ScrollContentPresenterContainer">
                            <ScrollContentPresenter
                                x:Name="PART_ScrollContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                CanHorizontallyScroll="False"
                                CanVerticallyScroll="False"
                                Content="{TemplateBinding Content}" />
                        </Border>

                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Margin="0"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="VerticalScrollBar"
                            Cursor="Arrow"
                            IsHitTestVisible="False"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            Opacity="0"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Margin="0"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="HorizontalScrollBar"
                            Cursor="Arrow"
                            IsHitTestVisible="False"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Minimum="0"
                            Opacity="0"
                            Orientation="Horizontal"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_HorizontalScrollBar" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger SourceName="PART_VerticalScrollBar" Property="IsMouseCaptureWithin" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger SourceName="PART_HorizontalScrollBar" Property="IsMouseCaptureWithin" Value="True">
                            <Setter TargetName="PART_HorizontalScrollBar" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundedProgressBarStyle" BasedOn="{StaticResource BaseProgressBarStyle}" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource Brush.Background.Deepened}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Account.Credit}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border
                        x:Name="BackgroundBorder"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <Border.CornerRadius>
                            <MultiBinding Converter="{StaticResource CornerRadiusConverter}">
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </Border.CornerRadius>
                        <Grid x:Name="PART_Track">
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{Binding ElementName=BackgroundBorder, Path=CornerRadius}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="AccountComboGroupHeaderTemplate">
        <StackPanel Margin="10,6,10,4">
            <Border
                Height="1.5"
                Margin="0,0,0,12"
                Background="{StaticResource Brush.Border.Subtle}"
                Opacity="0.45" />
            <TextBlock
                FontFamily="{StaticResource Bold}"
                FontSize="10"
                Foreground="{StaticResource Brush.Text.Muted}"
                Text="{Binding Name}" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="FluxoComboBoxItemStyle" BasedOn="{StaticResource BaseComboBoxItemStyle}" TargetType="ComboBoxItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Medium}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="ItemBackground"
                        Margin="2"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />

                            <Path
                                x:Name="SelectedCheckmark"
                                Grid.Column="1"
                                Width="10"
                                Height="10"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource Check}"
                                Fill="{TemplateBinding Foreground}"
                                Opacity="0"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource Brush.Background.Hover}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource Brush.Background.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource Brush.Background.Hover}" />
                            <Setter TargetName="SelectedCheckmark" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluxoComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="ComboBox">
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{StaticResource Brush.Background.Elevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Medium}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MaxDropDownHeight" Value="180" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FluxoComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton
                            x:Name="ToggleButton"
                            Height="{Binding Height, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            HorizontalAlignment="Stretch"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press"
                            Focusable="False"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        Padding="10,0,12,0"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ContentPresenter
                                                HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                VerticalAlignment="Center"
                                                Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                RecognizesAccessKey="True"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                TextElement.FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                TextElement.FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />

                                            <Path
                                                x:Name="DropDownChevron"
                                                Grid.Column="1"
                                                Width="8"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource AngleDown}"
                                                Fill="{StaticResource Brush.Text.Muted}"
                                                RenderTransformOrigin="0.5,0.5"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="DropDownChevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            HorizontalOffset="0"
                            IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            PopupAnimation="Fade"
                            VerticalOffset="8">
                            <Border
                                x:Name="DropDownBorder"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{StaticResource Brush.Background.Elevated}"
                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <customControls:FadingScrollViewer
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="4"
                                    CanContentScroll="False"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Hidden">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </customControls:FadingScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Mint}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BudgetSliderThumbStyle" BasedOn="{StaticResource BaseThumbStyle}" TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="ThumbCircle" Fill="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BudgetTrackButtonStyle" BasedOn="{StaticResource BaseRepeatButtonStyle}" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border
                        Height="4"
                        Margin="0,0,-8,0"
                        Background="{TemplateBinding Background}"
                        CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BudgetSliderStyle" BasedOn="{StaticResource BaseSliderStyle}" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Mint}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border
                            Height="4"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.Background.Hover}"
                            CornerRadius="3" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Background="{TemplateBinding Foreground}"
                                    Command="Slider.DecreaseLarge"
                                    Style="{StaticResource BudgetTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Foreground="{TemplateBinding Foreground}" Style="{StaticResource BudgetSliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Background="{StaticResource Brush.Background.Hover}"
                                    Command="Slider.IncreaseLarge"
                                    Style="{StaticResource BudgetTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
