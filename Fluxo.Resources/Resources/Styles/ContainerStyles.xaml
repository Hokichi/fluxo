<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="BaseFrameworkElementStyle" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Visible" />
    </Style>
    <Style x:Key="BaseBorderStyle" TargetType="Border" />
    <Style x:Key="BaseColumnDefinitionStyle" TargetType="ColumnDefinition" />
    <Style x:Key="BaseContentPresenterStyle" TargetType="ContentPresenter" />
    <Style x:Key="BaseGridStyle" TargetType="Grid" />
    <Style x:Key="BaseStackPanelStyle" TargetType="StackPanel" />
    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock" />

    <Style x:Key="CardBorderStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{StaticResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="VerticalSeparatorBorderStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
        <Setter Property="Width" Value="1.5" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource Brush.Border.Subtle}" />
    </Style>

</ResourceDictionary>
