<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components"
    xmlns:coreEnums="clr-namespace:Fluxo.Core.Enums;assembly=Fluxo.Core">

    <Style x:Key="BaseIconStyle" TargetType="components:Icon" />

    <Style x:Key="BaseTransactionsListStyle" TargetType="components:TransactionsList">
        <Setter Property="IsEmptyActionVisible" Value="True" />
        <Setter Property="MaxVisibleItems" Value="5" />
    </Style>

    <Style x:Key="Accounts" BasedOn="{StaticResource BaseListViewItemStyle}" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource PlainListViewItemTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PinnedOnUI}" Value="False">
                <Setter Property="Margin" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SpinnerArrowIconStyle" BasedOn="{StaticResource BaseIconStyle}" TargetType="components:Icon">
        <Setter Property="Color" Value="{DynamicResource Brush.Text.Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Color" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect
                            BlurRadius="2"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="White" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <DataTemplate x:Key="SavingGoalTemplate">
        <Border Margin="0,0,0,8" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="56" Height="56">
                    <Canvas
                        Width="80"
                        Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Ellipse
                            Canvas.Left="4"
                            Canvas.Top="4"
                            Width="72"
                            Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                            Stroke="{DynamicResource Brush.Background.Surface}"
                            StrokeThickness="8" />
                        <Path
                            Canvas.Left="8"
                            Canvas.Top="8"
                            Data="{Binding AnimatedProgressRatio, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource ProgressToArcGeometryConverter}, ConverterParameter=64}"
                            Stroke="{Binding AnimatedProgressRatio, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource GoalProgressToBrushConverter}}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="8" />
                    </Canvas>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Bold}"
                        FontSize="12"
                        Foreground="{Binding AnimatedProgressRatio, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource GoalProgressToBrushConverter}}"
                        Text="{Binding AnimatedProgressRatio, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, StringFormat={}{0:0%}}" />
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="{StaticResource Bold}"
                        FontSize="18"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.Text.Secondary}">
                        <Run
                            FontFamily="{StaticResource Black}"
                            Foreground="{Binding AnimatedProgressRatio, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource GoalProgressToBrushConverter}}"
                            Text="{Binding CurrentAmount, Converter={StaticResource MoneyAmountToCanonicalConverter}}" />
                        <Run FontFamily="{StaticResource Light}" Text="saved" />
                    </TextBlock>

                    <TextBlock
                        Margin="0,4,0,0"
                        FontFamily="{StaticResource Light}"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.Text.Secondary}">
                        <Run Text="{Binding RemainingAmount, Converter={StaticResource MoneyAmountToCanonicalConverter}}" />
                        <Run Text="left" />
                        <Run Text="&#x00B7;" />
                        <Run Text="target" />
                        <Run Text="{Binding TargetAmount, Converter={StaticResource MoneyAmountToCanonicalConverter}}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>


    <DataTemplate x:Key="Tags">
        <Grid>
            <Border
                Height="24"
                Margin="16,0,0,0"
                Padding="12,0"
                Background="{DynamicResource Brush.Background.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12"
                Cursor="Hand"
                Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}, Path=IsSelected, Converter={StaticResource BoolToVisibilityInvertedConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{Binding HexCode}" />

                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Bold}"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding Name}" />
                </StackPanel>
            </Border>

            <Border
                x:Name="SelectedTagPill"
                Height="24"
                Margin="16,0,0,0"
                Padding="12,0"
                Background="{Binding HexCode}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}, Path=IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{Binding HexCode, Converter={StaticResource BackgroundToForegroundConverter}}" />

                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Bold}"
                        Text="{Binding Name}">
                        <TextBlock.Foreground>
                            <Binding
                                Converter="{StaticResource BackgroundToForegroundConverter}"
                                Path="HexCode" />
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>


</ResourceDictionary>
