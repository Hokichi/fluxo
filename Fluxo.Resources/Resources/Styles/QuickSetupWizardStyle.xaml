<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <Style x:Key="QuickSetupWizardPopupStyle" BasedOn="{StaticResource {x:Type customControls:BasePopup}}" TargetType="{x:Type customControls:BasePopup}"><Setter Property="ShowCloseButton" Value="True" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsFinalStep, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="ShowCloseButton" Value="False" /></DataTrigger></Style.Triggers></Style>
    <Style x:Key="FieldLabelStyle" BasedOn="{StaticResource FieldLabelTextStyle}" TargetType="TextBlock" />
        <ControlTemplate x:Key="WizardCircleActionButtonTemplate" TargetType="Button"><Border x:Name="ButtonBackground" Background="{TemplateBinding Background}" CornerRadius="22"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource Brush.Mint.Muted}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBackground" Property="Opacity" Value="0.85" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBackground" Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate>

<Style x:Key="WizardCircleActionButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button"><Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="{DynamicResource Brush.Mint}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Background.Surface}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template" Value="{StaticResource WizardCircleActionButtonTemplate}" /></Style>
    <Style x:Key="QuickSetupPreviousChevronButtonStyle" BasedOn="{StaticResource DialogActionButtonStyle}" TargetType="Button"><Setter Property="MinWidth" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="0" /></Style>
    <Style x:Key="QuickSetupNextChevronButtonStyle" BasedOn="{StaticResource PrimaryDialogActionButtonStyle}" TargetType="Button"><Setter Property="MinWidth" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="0" /></Style>
    <ItemsPanelTemplate x:Key="WizardItemsPanelTemplate"><primitives:UniformGrid Columns="2" /></ItemsPanelTemplate>
    <Style x:Key="WizardItemContainerStyle" BasedOn="{StaticResource BaseContentPresenterStyle}" TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,12,12" /></Style>
</ResourceDictionary>
