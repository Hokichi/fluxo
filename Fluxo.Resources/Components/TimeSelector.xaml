<UserControl
    x:Class="Fluxo.Resources.Components.TimeSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Width="96"
    Focusable="True"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewTextInput="OnPreviewTextInput">

    <UserControl.Resources>
        <Style x:Key="TimeSegmentStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
    </UserControl.Resources>

    <Border
        Height="40"
        Padding="4,0"
        Background="{DynamicResource Brush.Background.Elevated}"
        BorderBrush="{DynamicResource Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Border
                x:Name="HoursSegment"
                MouseLeftButtonDown="OnHoursSegmentMouseLeftButtonDown"
                Style="{StaticResource TimeSegmentStyle}">
                <TextBlock
                    FontFamily="{DynamicResource Medium}"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="{Binding FormattedHours, ElementName=Root, Mode=OneWay}" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="{DynamicResource Medium}"
                Foreground="{DynamicResource Brush.Text.Muted}"
                Text=":" />
            <Border
                x:Name="MinutesSegment"
                MouseLeftButtonDown="OnMinutesSegmentMouseLeftButtonDown"
                Style="{StaticResource TimeSegmentStyle}">
                <TextBlock
                    FontFamily="{DynamicResource Medium}"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="{Binding FormattedMinutes, ElementName=Root, Mode=OneWay}" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
