<UserControl
    x:Class="Fluxo.Resources.Components.Account"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components"
    xmlns:converters="clr-namespace:Fluxo.Resources.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="140"
    Height="60"
    Visibility="{Binding PinnedOnUI, Converter={StaticResource BoolToVisibilityConverter}}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="AccountMetricTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>

        <Style x:Key="AccountMetricIconStyle" BasedOn="{StaticResource BaseIconStyle}" TargetType="components:Icon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <Style
            x:Key="AccountAccentStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AccountType}" Value="Checking">
                    <Setter Property="Background" Value="{DynamicResource Brush.Account.Checking}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Account.Checking}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccountType}" Value="Cash">
                    <Setter Property="Background" Value="{DynamicResource Brush.Account.Cash}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Account.Cash}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccountType}" Value="Credit">
                    <Setter Property="Background" Value="{DynamicResource Brush.Account.Credit}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Account.Credit}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccountType}" Value="Saving">
                    <Setter Property="Background" Value="{DynamicResource Brush.Account.Saving}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Account.Saving}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="AccountStateBorderStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mint}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="0.5"
                                    Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="0"
                                    Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border
            x:Name="BGCard"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0.1"
            Style="{StaticResource AccountAccentStyle}" />

        <Border
            x:Name="AccountCard"
            BorderThickness="0"
            CornerRadius="8"
            MouseLeftButtonDown="OnRootMouseLeftButtonDown"
            PreviewMouseRightButtonUp="OnRootPreviewMouseRightButtonUp"
            Style="{StaticResource AccountStateBorderStyle}">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource Color.Background.Deepened}" />
            </Border.Background>


        </Border>

        <Border
            Padding="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">
            <components:Icon
                Width="12"
                Height="16"
                Path="{StaticResource Check}"
                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                Color="{Binding ElementName=BGCard, Path=Background}" />
        </Border>

        <Border
            Background="Transparent"
            BorderThickness="2"
            CornerRadius="8"
            IsHitTestVisible="False"
            Opacity="0.5"
            Style="{StaticResource AccountAccentStyle}" />

        <Grid>
            <StackPanel Margin="12,8" IsHitTestVisible="False">
                <TextBlock
                    VerticalAlignment="Bottom"
                    FontFamily="{StaticResource SemiBold}"
                    FontSize="11"
                    Foreground="{Binding ElementName=BGCard, Path=Background}"
                    Text="{Binding Name}" />

                <TextBlock
                    Margin="0,4,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Bold}"
                    FontSize="20"
                    Foreground="{Binding Difference, Converter={StaticResource DifferenceToBrushConverter}}"
                    Text="{Binding Difference, Converter={StaticResource NumberWithCommasConverter}}"
                    ToolTip="{Binding SpentAmount, Converter={StaticResource MoneyFullDisplayConverter}}" />
            </StackPanel>
        </Grid>

        <Popup
            x:Name="AccountActionsPopup"
            AllowsTransparency="True"
            IsOpen="False"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=AccountCard}"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="8">
            <Border
                Width="220"
                Padding="8"
                Background="{DynamicResource Brush.Background.Elevated}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="18">
                <StackPanel>
                    <Button Click="OnViewActionClick" Style="{StaticResource HeaderMenuActionButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:Icon Style="{StaticResource AccountMetricIconStyle}"
                                Path="{StaticResource Eye}"
                                Color="{DynamicResource Brush.Info}" />
                            <TextBlock Style="{StaticResource AccountMetricTextStyle}"
                                Grid.Column="2"
                                Text="View" />
                        </Grid>
                    </Button>

                    <Button Click="OnDeleteActionClick" Style="{StaticResource HeaderMenuActionButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:Icon Style="{StaticResource AccountMetricIconStyle}"
                                Path="{StaticResource Delete}"
                                Color="{DynamicResource Brush.Danger}" />
                            <TextBlock Style="{StaticResource AccountMetricTextStyle}"
                                Grid.Column="2"
                                Text="Delete" />
                        </Grid>
                    </Button>

                    <Button Click="OnHideActionClick" Style="{StaticResource HeaderMenuActionButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:Icon Style="{StaticResource AccountMetricIconStyle}"
                                Path="{StaticResource Unpin}"
                                Color="{DynamicResource Brush.Warning}" />
                            <TextBlock Style="{StaticResource AccountMetricTextStyle}"
                                Grid.Column="2"
                                Text="Unpin" />
                        </Grid>
                    </Button>

                    <Button
                        Click="OnDisableActionClick"
                        IsEnabled="{Binding IsEnabled}"
                        Style="{StaticResource HeaderMenuActionButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:Icon Style="{StaticResource AccountMetricIconStyle}"
                                Path="{StaticResource LightningSlashFill}"
                                Color="{DynamicResource Brush.Warning}" />
                            <TextBlock Style="{StaticResource AccountMetricTextStyle}"
                                Grid.Column="2"
                                Text="Disable" />
                        </Grid>
                    </Button>

                    <Button
                        Click="OnTransferActionClick"
                        IsEnabled="{Binding CanTransfer}"
                        Style="{StaticResource HeaderMenuActionButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:Icon Style="{StaticResource AccountMetricIconStyle}"
                                Path="{StaticResource Exchange}"
                                Color="{DynamicResource Brush.Mint}" />
                            <TextBlock Style="{StaticResource AccountMetricTextStyle}"
                                Grid.Column="2"
                                Text="Transfer" />
                        </Grid>
                    </Button>

                    <Button
                        Click="OnRepaymentActionClick"
                        Style="{StaticResource HeaderMenuActionButtonStyle}"
                        Visibility="{Binding CanRepay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:Icon Style="{StaticResource AccountMetricIconStyle}"
                                Path="{StaticResource Bill}"
                                Color="{DynamicResource Brush.Mint}" />
                            <TextBlock Style="{StaticResource AccountMetricTextStyle}"
                                Grid.Column="2"
                                Text="Repayment" />
                        </Grid>
                    </Button>

                    <Button
                        Click="OnReconciliationActionClick"
                        Style="{StaticResource HeaderMenuActionButtonStyle}"
                        Visibility="{Binding CanReconcile, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:Icon Style="{StaticResource AccountMetricIconStyle}"
                                Path="{StaticResource MoneyExchange}"
                                Color="{DynamicResource Brush.Warning}" />
                            <TextBlock Style="{StaticResource AccountMetricTextStyle}"
                                Grid.Column="2"
                                Text="Reconciliation" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
