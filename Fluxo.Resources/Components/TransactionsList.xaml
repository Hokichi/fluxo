<UserControl
    x:Class="Fluxo.Resources.Components.TransactionsList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Fluxo.Resources.Behaviors"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fluxo.Resources.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

<UserControl.Resources>
        <Style x:Key="TransactionRowBorderStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}, Path=IsMouseOver}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=customControls:SwipeRevealContainer}, Path=IsRevealed}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransactionChildRowBorderStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}, Path=IsMouseOver}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=customControls:SwipeRevealContainer}, Path=IsRevealed}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="2" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransactionRowLayoutStyle" BasedOn="{StaticResource BaseGridStyle}" TargetType="Grid">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}, Path=IsMouseOver}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=customControls:SwipeRevealContainer}, Path=IsRevealed}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="4" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransactionAmountTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Mint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpense}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransactionsListHeaderText" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
        </Style>

        <Style x:Key="TransactionsListViewItemStyle" BasedOn="{StaticResource BaseListViewItemStyle}" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource PlainListViewItemTemplate}" />
        </Style>

        <DataTemplate x:Key="TransactionsListItemTemplate">
            <customControls:SwipeRevealContainer>
                <customControls:SwipeRevealContainer.LeftContent>
                    <customControls:BalloonButton
                        Width="32"
                        Height="32"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        ButtonIcon="{StaticResource Info}"
                        Click="OnTransactionDetailButtonClick"
                        DefaultBackground="{StaticResource Brush.BalloonButton.Background.NavInfo}"
                        HoveredBackground="{StaticResource Brush.BalloonButton.Background.NavInfo.Hovered}"
                        IconSize="12" />
                </customControls:SwipeRevealContainer.LeftContent>

                <customControls:SwipeRevealContainer.RightContent>
                    <customControls:BalloonButton
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        ButtonIcon="{StaticResource Delete}"
                        ButtonSize="32"
                        Click="OnDeleteButtonClick"
                        DefaultBackground="{StaticResource Brush.BalloonButton.Background.Destructive}"
                        HoveredBackground="{StaticResource Brush.BalloonButton.Background.Destructive.Hovered}"
                        IconSize="12" />
                </customControls:SwipeRevealContainer.RightContent>

                <Grid>
<Border
                        Margin="0,1,16,1"
                        Background="{Binding TagHexCode, FallbackValue=Transparent, TargetNullValue=Transparent}"
                        CornerRadius="12 0 0 12" Style="{StaticResource TransactionRowBorderStyle}">

                    </Border>

                    <Border CornerRadius="12">
                        <Border.Clip>
                            <MultiBinding Converter="{StaticResource BorderCornerClipConverter}">
                                <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType=Grid}" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource FindAncestor, AncestorType=Grid}" />
                            </MultiBinding>
                        </Border.Clip>
<Border
                            x:Name="ExpenseItemBGBorder"
                            Background="{StaticResource Brush.Background.Hover}"
                            ClipToBounds="True"
                            CornerRadius="12" Style="{StaticResource TransactionChildRowBorderStyle}">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>

                        </Border>
                    </Border>

                    <Border
                        x:Name="ExpenseItemBorder"
                        Background="Transparent"
                        CornerRadius="12">
                        <Grid
                            MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=ActualWidth}"
                            Margin="4,8"
                            HorizontalAlignment="Stretch"
                            ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

<Grid MinWidth="0" Style="{StaticResource TransactionRowLayoutStyle}">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>


                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="1"
                                    MinWidth="0"
                                    Margin="4,0"
                                    HorizontalAlignment="Stretch">
                                    <TextBlock
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Bold}"
                                        FontSize="14"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Regular}" FontSize="12">
                                            <Run Foreground="{StaticResource Brush.Text.Muted}" Text="{Binding Account.Name}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                MinWidth="0"
                                Margin="4,0"
                                HorizontalAlignment="Right">
<TextBlock
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource Bold}"
                                    FontSize="14"
                                    Text="{Binding AmountText}"
                                    ToolTip="{Binding Amount, Converter={StaticResource MoneyFullDisplayConverter}}" Style="{StaticResource TransactionAmountTextStyle}">

                                </TextBlock>
                                <TextBlock
                                    MaxWidth="120"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource Regular}"
                                    FontSize="12"
                                    Foreground="{StaticResource Brush.Text.Muted}"
                                    Text="{Binding OccurredOn, Converter={StaticResource DateTimeToRelativeDateConverter}}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </customControls:SwipeRevealContainer>
        </DataTemplate>

<Style BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock" x:Key="TransactionsEmptyStateTextStyle">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsListEmpty, RelativeSource={RelativeSource AncestorType={x:Type local:TransactionsList}}}" Value="True" />
                                        <Condition Binding="{Binding IsEmptyActionVisible, RelativeSource={RelativeSource AncestorType={x:Type local:TransactionsList}}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>

<ControlTemplate TargetType="{x:Type customControls:FadingScrollViewer}" x:Key="TransactionsFadingScrollViewerTemplate">
                            <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                                <Border x:Name="PART_ScrollContentPresenterContainer">
                                    <ScrollContentPresenter
                                        x:Name="PART_ScrollContentPresenter"
                                        Margin="{TemplateBinding Padding}"
                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                        CanHorizontallyScroll="False"
                                        CanVerticallyScroll="False"
                                        Content="{TemplateBinding Content}" />
                                </Border>

                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Margin="0,0,-16,0"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="VerticalScrollBar"
                                    Cursor="Arrow"
                                    IsHitTestVisible="False"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Minimum="0"
                                    Opacity="0"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                    Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />

                                <ScrollBar
                                    x:Name="PART_HorizontalScrollBar"
                                    Margin="0"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="HorizontalScrollBar"
                                    Cursor="Arrow"
                                    IsHitTestVisible="False"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    Minimum="0"
                                    Opacity="0"
                                    Orientation="Horizontal"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                    Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_VerticalScrollBar" Property="IsHitTestVisible" Value="True" />
                                    <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                                    <Setter TargetName="PART_HorizontalScrollBar" Property="IsHitTestVisible" Value="True" />
                                    <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger SourceName="PART_VerticalScrollBar" Property="IsMouseCaptureWithin" Value="True">
                                    <Setter TargetName="PART_VerticalScrollBar" Property="IsHitTestVisible" Value="True" />
                                    <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger SourceName="PART_HorizontalScrollBar" Property="IsMouseCaptureWithin" Value="True">
                                    <Setter TargetName="PART_HorizontalScrollBar" Property="IsHitTestVisible" Value="True" />
                                    <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
</UserControl.Resources>

    <Grid VerticalAlignment="Stretch" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="12,2,0,0"
            VerticalAlignment="Center"
            FontFamily="{StaticResource ExtraBold}"
            FontSize="14"
            Foreground="{Binding DotColor, RelativeSource={RelativeSource AncestorType={x:Type local:TransactionsList}}}"
            Text="RECENT ACTIVITIES" />

        <customControls:BalloonButton
            Margin="12,0"
            HorizontalAlignment="Right"
            ButtonIcon="{StaticResource BookAiFill}"
            ButtonText="View in Ledger"
            Click="OnViewInLedgerButtonClick"
            CornerRadius="8"
            DefaultBackground="{StaticResource Brush.Mint.Muted}"
            HoveredBackground="{StaticResource Brush.Mint}"
            IconSize="12"
            ShouldExpand="True" />


        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="12,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource TransactionsListHeaderText}" Text="ITEM" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource TransactionsListHeaderText}"
                    Text="AMOUNT" />
            </Grid>

            <Border
                Grid.Row="1"
                Height="1"
                Margin="12,0,12,12"
                Background="{StaticResource Brush.Text.Muted}"
                Opacity="0.25" />

            <Grid Grid.Row="2">
<TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Bold}"
                    FontSize="14"
                    Foreground="{StaticResource Brush.Text.Muted}"
                    Text="{Binding EmptyActionText, RelativeSource={RelativeSource AncestorType={x:Type local:TransactionsList}}}" Style="{StaticResource TransactionsEmptyStateTextStyle}">

                </TextBlock>

<customControls:FadingScrollViewer
                    Margin="4,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FadedEdgeThickness="20"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto" Template="{StaticResource TransactionsFadingScrollViewerTemplate}">

                    <ListView
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        behaviors:ScrollOnDemandBehavior.HasMoreItems="{Binding HasMoreItems, RelativeSource={RelativeSource AncestorType={x:Type local:TransactionsList}}}"
                        behaviors:ScrollOnDemandBehavior.IsEnabled="True"
                        behaviors:ScrollOnDemandBehavior.IsLoading="{Binding IsLoading, RelativeSource={RelativeSource AncestorType={x:Type local:TransactionsList}}}"
                        behaviors:ScrollOnDemandBehavior.LoadMoreCommand="{Binding LoadMoreCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TransactionsList}}}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ClipToBounds="True"
                        ItemContainerStyle="{StaticResource TransactionsListViewItemStyle}"
                        ItemTemplate="{StaticResource TransactionsListItemTemplate}"
                        ItemsSource="{Binding VisibleItemsSource, RelativeSource={RelativeSource AncestorType={x:Type local:TransactionsList}}}"
                        PreviewMouseWheel="OnTransactionsListPreviewMouseWheel"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                </customControls:FadingScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
