<Project>
  <Target Name="ValidateFluxoReleaseVersion" BeforeTargets="BeforeBuild;Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(FluxoInstallerVersion)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'))"
           Text="Invalid release version: use a numeric major.minor.patch FluxoInstallerVersion." />
    <PropertyGroup>
      <_FluxoReleaseMajor>$([System.Version]::Parse('$(FluxoInstallerVersion)').Major)</_FluxoReleaseMajor>
      <_FluxoReleaseMinor>$([System.Version]::Parse('$(FluxoInstallerVersion)').Minor)</_FluxoReleaseMinor>
      <_FluxoReleasePatch>$([System.Version]::Parse('$(FluxoInstallerVersion)').Build)</_FluxoReleasePatch>
    </PropertyGroup>
    <Error Condition="$(_FluxoReleaseMajor) &gt; 255 or $(_FluxoReleaseMinor) &gt; 255 or $(_FluxoReleasePatch) &gt; 65535"
           Text="Invalid release version: MSI requires major/minor &lt;= 255 and patch &lt;= 65535." />
    <Error Condition="'$(Version)' != '$(FluxoInstallerVersion)' or '$(FluxoMsiVersion)' != '$(FluxoInstallerVersion)' or '$(FileVersion)' != '$(FluxoInstallerVersion).0'"
           Text="Conflicting release versions: set only FluxoInstallerVersion. Version, FluxoMsiVersion and FileVersion must match it." />
  </Target>
</Project>
