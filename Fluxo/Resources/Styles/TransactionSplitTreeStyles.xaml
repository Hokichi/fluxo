<ResourceDictionary
    x:Class="Fluxo.Resources.Styles.TransactionSplitTreeStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources">

    <Style x:Key="TransactionCardStatusIconStyle" BasedOn="{StaticResource BaseIconStyle}" TargetType="components:Icon">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Color" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Path" Value="{StaticResource ExclamationTriangle}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsValid, Mode=OneWay}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsValid, Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding HasWarnings, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Color" Value="{DynamicResource Brush.Warning}" />
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

        <ControlTemplate x:Key="SplitTransactionTreeViewTemplate" TargetType="TreeViewItem">
                                    <ContentPresenter ContentSource="Header" />
                                </ControlTemplate>

    <Style x:Key="SplitTransactionTreeItemContainerStyle" BasedOn="{StaticResource BaseTreeViewItemStyle}" TargetType="TreeViewItem">
                        <Setter Property="Template" Value="{StaticResource SplitTransactionTreeViewTemplate}" />
                    </Style>

<Style x:Key="SplitTransactionTreeViewStyle" BasedOn="{StaticResource BaseTreeViewStyle}" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SplitTransactionTreeItemContainerStyle}" />
    </Style>

        <ControlTemplate x:Key="SplitTransactionCardTemplate" TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>

<Style x:Key="SplitTransactionCardStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Template" Value="{StaticResource SplitTransactionCardTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mint}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="SplitTransactionRootCardStyle"
        BasedOn="{StaticResource SplitTransactionCardStyle}"
        TargetType="Button">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedSplitTransaction, Mode=OneWay}" Value="{x:Null}">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mint}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="SplitTransactionLeafTemplate">
        <Grid Margin="32,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Border.Strong}" />
                <customControls:BalloonButton
                    Grid.Row="1"
                    Margin="0,4"
                    ButtonIcon="{StaticResource Delete}"
                    ButtonText="Delete"
                    Command="{Binding SplitsViewModel.DeleteSplitCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    ToolTip="Delete"
                    Visibility="{Binding SplitsViewModel.CanModifySplitTree, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Border
                    Grid.Row="2"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Border.Strong}" />
            </Grid>
            <Button
                Grid.Column="2"
                Margin="0,8,0,0"
                Click="OnSplitCardClick"
                Command="{Binding SplitsViewModel.SelectSplitCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                CommandParameter="{Binding}"
                Style="{StaticResource SplitTransactionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontFamily="{StaticResource Bold}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <components:Icon
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource TransactionCardStatusIconStyle}" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,0,0">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="{StaticResource Bold}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>
    </DataTemplate>

    <Style
        x:Key="TransactionSplitProgressStyle"
        BasedOn="{StaticResource RoundedProgressBarStyle}"
        TargetType="ProgressBar">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasChildAmountOverflow, Mode=OneWay}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="SplitTransactionBranchTemplate">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Border.Strong}" />
                    <customControls:BalloonButton
                        Grid.Row="1"
                        Margin="0,4"
                        ButtonIcon="{StaticResource Delete}"
                        ButtonText="Delete"
                        Command="{Binding SplitsViewModel.DeleteSplitCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                        CommandParameter="{Binding}"
                        ToolTip="Delete"
                        Visibility="{Binding SplitsViewModel.CanModifySplitTree, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Border
                        Grid.Row="2"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Border.Strong}" />
                </Grid>
                <Button
                    Grid.Column="2"
                    Margin="0,8,0,0"
                    Click="OnSplitCardClick"
                    Command="{Binding SplitsViewModel.SelectSplitCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                    CommandParameter="{Binding}"
                    MouseDoubleClick="OnSplitCardMouseDoubleClick"
                    Style="{StaticResource SplitTransactionCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontFamily="{StaticResource Bold}"
                                    Foreground="{DynamicResource Brush.Text.Primary}"
                                    Text="{Binding Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <components:Icon
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource TransactionCardStatusIconStyle}" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource Bold}"
                                    Foreground="{DynamicResource Brush.Text.Primary}"
                                    Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                            </StackPanel>
                        </Grid>
<ProgressBar
                            Height="12"
                            Margin="0,12,0,0"
                            Maximum="{Binding Amount, Mode=OneWay}"
                            Visibility="{Binding IsLeaf, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}"
                            Value="{Binding ChildAmountTotal, Mode=OneWay}" Style="{StaticResource TransactionSplitProgressStyle}">

                        </ProgressBar>
                        <Grid Margin="0,8,0,0" Visibility="{Binding IsLeaf, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Medium}"
                                Foreground="{DynamicResource Brush.Text.Primary}">
                                <Run Text="{Binding ChildAmountDisplay, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                                <Run Text="{Binding ChildAmountStatus, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <customControls:BalloonButton
                                    Margin="0,0,8,0"
                                    ButtonIcon="{StaticResource CallSplit}"
                                    ButtonText="Split Equally"
                                    Command="{Binding SplitsViewModel.SplitEquallyCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="8"
                                    DefaultBackground="{DynamicResource Brush.BalloonButton.Background.Surface}"
                                    HoveredBackground="{DynamicResource Brush.BalloonButton.Background.Surface.Hovered}"
                                    ShouldShowText="True" />
                                <customControls:BalloonButton
                                    ButtonIcon="{StaticResource RegularUndo}"
                                    ButtonText="Reset"
                                    Command="{Binding SplitsViewModel.ResetSplitCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="8"
                                    DefaultBackground="{DynamicResource Brush.BalloonButton.Background.Surface}"
                                    HoveredBackground="{DynamicResource Brush.BalloonButton.Background.Surface.Hovered}"
                                    ShouldShowText="True" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Border.Strong}" />
                <StackPanel Grid.Column="1" Margin="0,4,0,0">
                    <TreeView
                        Margin="-32,0,0,0"
                        ItemTemplate="{StaticResource SplitTransactionLeafTemplate}"
                        ItemsSource="{Binding ChildTransactions, Mode=OneWay}"
                        Style="{StaticResource SplitTransactionTreeViewStyle}" />
                    <StackPanel
                        Width="32"
                        Margin="1,-1,0,0"
                        HorizontalAlignment="Left">
                        <Border
                            Width="1"
                            Height="20"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource Brush.Border.Strong}" />
                        <customControls:BalloonButton
                            Margin="2,4,0,0"
                            HorizontalAlignment="Left"
                            ButtonIcon="{StaticResource PlusSolid}"
                            Command="{Binding SplitsViewModel.AddSplitCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding CanAddChildTransaction, Mode=OneWay}"
                            ToolTip="Add a sub-transaction"
                            Visibility="{Binding SplitsViewModel.CanModifySplitTree, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
