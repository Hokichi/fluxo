<ResourceDictionary
    x:Class="Fluxo.Resources.Styles.TransactionSplitTreeStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources">

    <Style x:Key="SplitTransactionTreeViewStyle" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SplitTransactionCardStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Background.Hover}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Mint}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="SplitTransactionLeafTemplate">
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Width="1" HorizontalAlignment="Center" Background="{StaticResource Brush.Border.Subtle}" />
                <customControls:BalloonButton
                    Grid.Row="1"
                    ButtonIcon="{StaticResource Delete}"
                    ButtonText="Delete"
                    ToolTip="Delete"
                    Command="{Binding DataContext.DeleteSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
                <Border Grid.Row="2" Width="1" HorizontalAlignment="Center" Background="{StaticResource Brush.Border.Subtle}" />
            </Grid>
            <Button
                Grid.Column="1"
                Command="{Binding DataContext.SelectSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                Style="{StaticResource SplitTransactionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource Bold}" Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" FontFamily="{StaticResource Bold}" Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                </Grid>
            </Button>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SplitTransactionBranchTemplate">
        <StackPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Width="1" HorizontalAlignment="Center" Background="{StaticResource Brush.Border.Subtle}" />
                    <customControls:BalloonButton
                        Grid.Row="1"
                        ButtonIcon="{StaticResource Delete}"
                        ButtonText="Delete"
                        ToolTip="Delete"
                        Command="{Binding DataContext.DeleteSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                    <Border Grid.Row="2" Width="1" HorizontalAlignment="Center" Background="{StaticResource Brush.Border.Subtle}" />
                </Grid>
                <Button
                    Grid.Column="1"
                    Command="{Binding DataContext.SelectSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    MouseDoubleClick="OnSplitCardMouseDoubleClick"
                    Style="{StaticResource SplitTransactionCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{StaticResource Bold}" Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" FontFamily="{StaticResource Bold}" Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                        </Grid>
                        <ProgressBar
                            Height="12"
                            Margin="0,12,0,0"
                            Maximum="{Binding Amount, Mode=OneWay}"
                            Style="{StaticResource RoundedProgressBarStyle}"
                            Value="{Binding ChildAmountTotal, Mode=OneWay}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Medium}">
                                <Run Text="{Binding ChildAmountRemaining, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                                <Run Text=" left" />
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <customControls:BalloonButton
                                    Margin="0,0,8,0"
                                    ButtonIcon="{StaticResource CallSplit}"
                                    ButtonText="Split Equally"
                                    Command="{Binding DataContext.SplitEquallyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ShouldShowText="True" />
                                <customControls:BalloonButton
                                    ButtonIcon="{StaticResource RegularUndo}"
                                    ButtonText="Reset"
                                    Command="{Binding DataContext.ResetSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ShouldShowText="True" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Button>
            </Grid>
            <TreeView
                ItemTemplate="{StaticResource SplitTransactionLeafTemplate}"
                ItemsSource="{Binding ChildTransactions, Mode=OneWay}"
                Style="{StaticResource SplitTransactionTreeViewStyle}" />
            <customControls:BalloonButton
                Margin="32,8,0,0"
                ButtonText="+"
                Command="{Binding DataContext.AddSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                ToolTip="Add sub-transaction" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
