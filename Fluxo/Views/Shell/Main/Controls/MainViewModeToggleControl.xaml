<UserControl
    x:Class="Fluxo.Views.Shell.Main.Controls.MainViewModeToggleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:enums="clr-namespace:Fluxo.Core.Enums;assembly=Fluxo.Core"
    xmlns:viewModels="clr-namespace:Fluxo.ViewModels.Shell">
    <UserControl.Resources>
<Style x:Key="MoveToCurrentPeriodButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Medium}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock
                        Padding="{TemplateBinding Padding}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{TemplateBinding Foreground}"
                        Text="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Mint}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsAtCurrentPeriod}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSpinnerVisible}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    </UserControl.Resources>

    <StackPanel>
        <customControls:SegmentedToggleGroup Width="600" SelectedValue="{Binding SelectedMainContentViewMode, Mode=OneWay}">
            <customControls:SegmentedToggleOption
                Click="OnViewModeButtonClick"
                CommandParameter="{x:Static enums:MainContentViewMode.Daily}"
                Content="Day"
                IsSelected="{Binding IsDailyViewSelected, Mode=OneWay}"
                SelectOnClick="False"
                Value="{x:Static enums:MainContentViewMode.Daily}" />

            <customControls:SegmentedToggleOption
                Click="OnViewModeButtonClick"
                CommandParameter="{x:Static enums:MainContentViewMode.Weekly}"
                Content="Week"
                IsSelected="{Binding IsWeeklyViewSelected, Mode=OneWay}"
                SelectOnClick="False"
                Value="{x:Static enums:MainContentViewMode.Weekly}" />

            <customControls:SegmentedToggleOption
                Click="OnViewModeButtonClick"
                CommandParameter="{x:Static enums:MainContentViewMode.Monthly}"
                Content="Month"
                IsSelected="{Binding IsMonthlyViewSelected, Mode=OneWay}"
                SelectOnClick="False"
                Value="{x:Static enums:MainContentViewMode.Monthly}" />

            <customControls:SegmentedToggleOption
                Click="OnViewModeButtonClick"
                CommandParameter="{x:Static enums:MainContentViewMode.AllocationPeriod}"
                Content="Allocation Period"
                IsSelected="{Binding IsAllocationPeriodViewSelected, Mode=OneWay}"
                SelectOnClick="False"
                Value="{x:Static enums:MainContentViewMode.AllocationPeriod}" />

            <customControls:SegmentedToggleOption
                Click="OnViewModeButtonClick"
                CommandParameter="{x:Static enums:MainContentViewMode.AllTime}"
                Content="All-time"
                IsSelected="{Binding IsAllTimeViewSelected, Mode=OneWay}"
                SelectOnClick="False"
                Value="{x:Static enums:MainContentViewMode.AllTime}" />
        </customControls:SegmentedToggleGroup>
        <Button
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            Click="OnMoveToCurrentPeriodButtonClick"
            Content="{Binding MoveToCurrentLabel}"
            Cursor="Hand"
            Style="{StaticResource MoveToCurrentPeriodButtonStyle}"
            Visibility="{Binding IsAtCurrentPeriod, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}" />
    </StackPanel>
</UserControl>
