<UserControl
    x:Class="Fluxo.Views.Shell.Main.Sections.RecentActivities"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:enums="clr-namespace:Fluxo.Core.Enums;assembly=Fluxo.Core">
<UserControl.Resources>
<DataTemplate x:Key="PopupTags">
        <Grid>
            <Border
                Height="24"
                Padding="12,0"
                Background="{DynamicResource Brush.Background.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}, Path=IsSelected, Converter={StaticResource BoolToVisibilityInvertedConverter}, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="6"
                        Height="6"
                        Fill="{Binding HexCode}" />

                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Bold}"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding Name}" />
                </StackPanel>
            </Border>

            <Border
                x:Name="SelectedPopupTagPill"
                Height="24"
                Padding="12,0"
                Background="{Binding HexCode}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}, Path=IsSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="6"
                        Height="6"
                        Fill="{Binding HexCode, Converter={StaticResource BackgroundToForegroundConverter}}" />

                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Bold}"
                        Text="{Binding Name}">
                        <TextBlock.Foreground>
                            <Binding
                                Converter="{StaticResource BackgroundToForegroundConverter}"
                                Path="HexCode" />
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
<Style x:Key="PopupTagListViewItemStyle" BasedOn="{StaticResource PlainListViewItemStyle}" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
<ControlTemplate x:Key="TagToggleButtonTemplate" TargetType="ToggleButton">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>

<Style x:Key="TagToggleButtonStyle" BasedOn="{StaticResource BaseToggleButtonStyle}" TargetType="ToggleButton">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Bold}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template" Value="{StaticResource TagToggleButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Mint}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mint}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Background.Surface}" />
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Mint}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mint}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Background.Surface}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
        <Style x:Key="BudgetAllocationVisibleTagListViewItemStyle" BasedOn="{StaticResource PlainListViewItemStyle}" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="BudgetAllocationTransactionsListStyle" BasedOn="{StaticResource BaseTransactionsListStyle}" TargetType="components:TransactionsList">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSufficientFundsActionGateLocked, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                    <Setter Property="IsEmptyActionVisible" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWindowLayoutMaximized, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                    <Setter Property="MaxVisibleItems" Value="8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

<Style BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border" x:Key="VisibleBudgetTagBorderStyle">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTag}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

<Style BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border" x:Key="HiddenBudgetTagBorderStyle">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTag}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
</UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="1"
            Height="32"
            Margin="0,0,0,16"
            Orientation="Horizontal">
            <Grid Margin="16,0,0,0" VerticalAlignment="Center">
<Border
                    x:Name="AllTagUnselected"
                    Height="24"
                    Padding="12,0"
                    Background="{DynamicResource Brush.Background.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Cursor="Hand" Style="{StaticResource VisibleBudgetTagBorderStyle}">

                    <Border.InputBindings>
                        <MouseBinding Command="{Binding ClearSelectedTagCommand}" MouseAction="LeftClick" />
                    </Border.InputBindings>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Bold}"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="All" />
                </Border>

<Border
                    x:Name="AllTagSelected"
                    Height="24"
                    Padding="12,0"
                    Background="{DynamicResource Brush.Mint}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Cursor="Hand" Style="{StaticResource HiddenBudgetTagBorderStyle}">

                    <Border.InputBindings>
                        <MouseBinding Command="{Binding ClearSelectedTagCommand}" MouseAction="LeftClick" />
                    </Border.InputBindings>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Bold}"
                        Foreground="{DynamicResource Brush.Background.Surface}"
                        Text="All" />
                </Border>
            </Grid>

            <ListView
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource BudgetAllocationVisibleTagListViewItemStyle}"
                ItemTemplate="{StaticResource Tags}"
                ItemsPanel="{StaticResource HorizontalStackItemsPanelTemplate}"
                ItemsSource="{Binding Tags}"
                PreviewMouseLeftButtonDown="OnTagListPreviewMouseLeftButtonDown"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedVisibleTag}" />

            <ToggleButton
                x:Name="MoreTagsButton"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Content="More"
                Style="{StaticResource TagToggleButtonStyle}"
                Tag="{Binding IsSelectedTagInOtherTags}"
                Visibility="{Binding HasOtherTags, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

            <Popup
                AllowsTransparency="True"
                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                IsOpen="{Binding IsChecked, ElementName=MoreTagsButton, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=MoreTagsButton}"
                PopupAnimation="Fade"
                StaysOpen="False"
                VerticalOffset="8">
                <Border
                    Padding="12"
                    Background="{DynamicResource Brush.Background.Elevated}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid MaxWidth="320">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            FontFamily="{StaticResource Bold}"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="More tags" />

                        <customControls:FadingScrollViewer
                            Grid.Row="2"
                            MaxHeight="240"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ListView
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource PopupTagListViewItemStyle}"
                                ItemTemplate="{StaticResource PopupTags}"
                                ItemsPanel="{StaticResource PopupWrapItemsPanelTemplate}"
                                ItemsSource="{Binding OtherTags}"
                                PreviewMouseLeftButtonDown="OnTagListPreviewMouseLeftButtonDown"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedOtherTag}"
                                SelectionChanged="OnMoreTagsSelectionChanged" />
                        </customControls:FadingScrollViewer>
                    </Grid>
                </Border>
            </Popup>
        </StackPanel>

        <Grid Grid.Row="2">
            <components:TransactionsList
                Title="NEEDS"
                DeleteCommand="{Binding DeleteExpenseLogCommand}"
                DotColor="{DynamicResource Brush.Category.Needs}"
                EmptyActionText="No transaction found"
                IsEmptyActionVisible="False"
                IsListEmpty="{Binding IsTransactionsEmpty}"
                ItemsSource="{Binding Transactions}"
                Style="{StaticResource BudgetAllocationTransactionsListStyle}" />
        </Grid>
    </Grid>
</UserControl>
