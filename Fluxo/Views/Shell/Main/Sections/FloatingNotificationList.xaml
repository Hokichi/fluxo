<UserControl
    x:Class="Fluxo.Views.Shell.Main.Sections.FloatingNotificationList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreEnums="clr-namespace:Fluxo.Core.Enums;assembly=Fluxo.Core"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources">
<UserControl.Resources>
        <Style x:Key="NotificationAccentStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static coreEnums:NotificationSeverity.Success}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static coreEnums:NotificationSeverity.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static coreEnums:NotificationSeverity.Danger}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

<DataTemplate x:Key="FloatingNotificationDetailTemplate">
                                            <TextBlock
                                                FontSize="7.5"
                                                Foreground="{DynamicResource Brush.Text.Secondary}"
                                                Text="{Binding StringFormat=• {0}, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>

<Style BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border" x:Key="FloatingNotificationCardStyle">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="0"
                                                    Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <DataTrigger Binding="{Binding IsClosing, Mode=OneWay}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0"
                                                        Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

<DataTemplate x:Key="FloatingNotificationTemplate">
                    <Border
                        Height="54"
                        Margin="6,3"
                        Padding="13.5,10.5"
                        Background="{DynamicResource Brush.Background.Surface}"
                        CornerRadius="12"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnCardClick"
                        Style="{StaticResource FloatingNotificationCardStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Opacity="0.35"
                                ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.75" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Style="{StaticResource NotificationAccentStyle}" />
                            <StackPanel Grid.Column="1" Margin="10.5,0,0,0">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.Text.Primary}">
                                    <Run
                                        FontFamily="{StaticResource Bold}"
                                        Text="{Binding Header, Mode=OneWay}" />
                                    <Run
                                        FontFamily="{StaticResource Regular}"
                                        Foreground="{DynamicResource Brush.Text.Secondary}"
                                        Text="{Binding HeaderAction, StringFormat={} {0}, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontFamily="{StaticResource Regular}"
                                    FontSize="9"
                                    Foreground="{DynamicResource Brush.Text.Secondary}"
                                    Text="{Binding Message, Mode=OneWay}"
                                    TextWrapping="Wrap" />
<ItemsControl Margin="0,4.5,0,0" ItemsSource="{Binding Details, Mode=OneWay}" ItemTemplate="{StaticResource FloatingNotificationDetailTemplate}">

                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                    </Border>
                </DataTemplate>
</UserControl.Resources>
    <customControls:FadingScrollViewer
        x:Name="NotificationScrollViewer"
        Width="270"
        MaxHeight="180"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Hidden">
<ItemsControl ItemsSource="{Binding Items, Mode=OneWay}" ItemTemplate="{StaticResource FloatingNotificationTemplate}">

        </ItemsControl>
    </customControls:FadingScrollViewer>
</UserControl>
