<UserControl
    x:Class="Fluxo.Views.Shell.Wizard.Pages.QuickSetupWizardMiddlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:steps="clr-namespace:Fluxo.Views.Shell.Wizard.Pages.Steps">
    <UserControl.Resources>
        <Style x:Key="WizardStep1SidebarStyle" BasedOn="{StaticResource SidebarStepStyle}" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStep2SidebarStyle" BasedOn="{StaticResource SidebarStepStyle}" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStep3SidebarStyle" BasedOn="{StaticResource SidebarStepStyle}" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStep4SidebarStyle" BasedOn="{StaticResource SidebarStepStyle}" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep5Active}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStep5SidebarStyle" BasedOn="{StaticResource SidebarStepStyle}" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep6Active}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStep6SidebarStyle" BasedOn="{StaticResource SidebarStepStyle}" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep7Active}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStep7SidebarStyle" BasedOn="{StaticResource SidebarStepStyle}" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep8Active}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardFinishButtonStyle" BasedOn="{StaticResource PrimaryDialogActionButtonStyle}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar  -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock
                    FontFamily="{StaticResource Bold}"
                    FontSize="14"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="Setup Steps" />
                <TextBlock
                    Margin="0,6,0,16"
                    FontFamily="{StaticResource Medium}"
                    FontSize="11"
                    Foreground="{DynamicResource Brush.Text.Muted}"
                    Text="{Binding StepCounterText}" />

                <!--  Step 1  -->
                <Border Style="{StaticResource WizardStep1SidebarStyle}">
                    <Grid>
                        <Border
                            x:Name="Step1Stripe"
                            Width="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Mint}"
                            CornerRadius="0"
                            Opacity="0" />
                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <components:Icon
                                Width="12"
                                Height="12"
                                Path="{StaticResource BookDollar}"
                                Color="{Binding Foreground, ElementName=Step1Label}" />
                            <TextBlock
                                x:Name="Step1Label"
                                Margin="10,0,0,0"
                                FontFamily="{StaticResource Bold}"
                                FontSize="12"
                                Foreground="{Binding MiddleCurrentStep, Mode=OneWay, Converter={StaticResource WizardStepForegroundConverter}, ConverterParameter=1}"
                                Text="Accounts" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Step 2  -->
                <Border Style="{StaticResource WizardStep2SidebarStyle}" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Border
                            x:Name="Step2Stripe"
                            Width="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Mint}"
                            CornerRadius="2"
                            Opacity="0" />
                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <components:Icon
                                Width="12"
                                Height="12"
                                Path="{StaticResource InvoiceLight}"
                                Color="{Binding Foreground, ElementName=Step2Label}" />
                            <TextBlock
                                x:Name="Step2Label"
                                Margin="10,0,0,0"
                                FontFamily="{StaticResource Bold}"
                                FontSize="12"
                                Foreground="{Binding MiddleCurrentStep, Mode=OneWay, Converter={StaticResource WizardStepForegroundConverter}, ConverterParameter=2}"
                                Text="Recurring Transactions" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Step 3  -->
                <Border Style="{StaticResource WizardStep3SidebarStyle}" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Border
                            x:Name="Step3Stripe"
                            Width="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Mint}"
                            CornerRadius="2"
                            Opacity="0" />
                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <components:Icon
                                Width="12"
                                Height="12"
                                Path="{StaticResource BullseyeSolid}"
                                Color="{Binding Foreground, ElementName=Step3Label}" />
                            <TextBlock
                                x:Name="Step3Label"
                                Margin="10,0,0,0"
                                FontFamily="{StaticResource Bold}"
                                FontSize="12"
                                Foreground="{Binding MiddleCurrentStep, Mode=OneWay, Converter={StaticResource WizardStepForegroundConverter}, ConverterParameter=3}"
                                Text="Savings Goals" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Step 4  -->
                <Border Style="{StaticResource WizardStep4SidebarStyle}" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Border
                            x:Name="Step4Stripe"
                            Width="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Mint}"
                            CornerRadius="2"
                            Opacity="0" />
                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <components:Icon
                                Width="12"
                                Height="12"
                                Path="{StaticResource AccountBalanceWalletRound}"
                                Color="{Binding Foreground, ElementName=Step4Label}" />
                            <TextBlock
                                x:Name="Step4Label"
                                Margin="10,0,0,0"
                                FontFamily="{StaticResource Bold}"
                                FontSize="12"
                                Foreground="{Binding MiddleCurrentStep, Mode=OneWay, Converter={StaticResource WizardStepForegroundConverter}, ConverterParameter=4}"
                                Text="Budget Allocation" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Step 5  -->
                <Border Style="{StaticResource WizardStep5SidebarStyle}">
                    <Grid>
                        <Border
                            x:Name="Step5Stripe"
                            Width="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Mint}"
                            CornerRadius="2"
                            Opacity="0" />
                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <components:Icon
                                Width="12"
                                Height="12"
                                Path="{StaticResource Lock}"
                                Color="{Binding Foreground, ElementName=Step5Label}" />
                            <TextBlock
                                x:Name="Step5Label"
                                Margin="10,0,0,0"
                                FontFamily="{StaticResource Bold}"
                                FontSize="12"
                                Foreground="{Binding MiddleCurrentStep, Mode=OneWay, Converter={StaticResource WizardStepForegroundConverter}, ConverterParameter=5}"
                                Text="Personalization" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Step 6  -->
                <Border Style="{StaticResource WizardStep6SidebarStyle}">
                    <Grid>
                        <Border
                            x:Name="Step6Stripe"
                            Width="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Mint}"
                            CornerRadius="2"
                            Opacity="0" />
                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <components:Icon
                                Width="12"
                                Height="12"
                                Path="{StaticResource RegularBell}"
                                Color="{Binding Foreground, ElementName=Step6Label}" />
                            <TextBlock
                                x:Name="Step6Label"
                                Margin="10,0,0,0"
                                FontFamily="{StaticResource Bold}"
                                FontSize="12"
                                Foreground="{Binding MiddleCurrentStep, Mode=OneWay, Converter={StaticResource WizardStepForegroundConverter}, ConverterParameter=6}"
                                Text="Preferences" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Step 7  -->
                <Border Style="{StaticResource WizardStep7SidebarStyle}">
                    <Grid>
                        <Border
                            x:Name="Step7Stripe"
                            Width="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Mint}"
                            CornerRadius="2"
                            Opacity="0" />
                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <components:Icon
                                Width="12"
                                Height="12"
                                Path="{StaticResource InvoiceLight}"
                                Color="{Binding Foreground, ElementName=Step7Label}" />
                            <TextBlock
                                x:Name="Step7Label"
                                Margin="10,0,0,0"
                                FontFamily="{StaticResource Bold}"
                                FontSize="12"
                                Foreground="{Binding MiddleCurrentStep, Mode=OneWay, Converter={StaticResource WizardStepForegroundConverter}, ConverterParameter=7}"
                                Text="Summary" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!--  Content Area  -->
        <Border
            x:Name="ContentColumn"
            Grid.Column="2"
            Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="StepContent" Grid.RowSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            FontFamily="{StaticResource Bold}"
                            FontSize="22"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding CurrentStepTitle}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontFamily="{StaticResource Medium}"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            Text="{Binding CurrentStepDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Sticky Add Buttons  -->
                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <Button
                            Click="OnAddAccountClick"
                            Style="{StaticResource AddTileButtonStyle}"
                            Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            Click="OnAddRecurringTransactionClick"
                            Style="{StaticResource AddTileButtonStyle}"
                            Visibility="{Binding IsStep3Active, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            Click="OnAddSavingGoalClick"
                            Style="{StaticResource AddTileButtonStyle}"
                            Visibility="{Binding IsStep4Active, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <customControls:FadingScrollViewer
                        x:Name="MiddleStepScrollViewer"
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <steps:Accounts DataContext="{Binding Accounts}" />
                            <steps:RecurringTransactions DataContext="{Binding RecurringTransactions}" />
                            <steps:SavingGoals DataContext="{Binding SavingGoals}" />
                            <steps:BudgetAllocation DataContext="{Binding BudgetAllocation}" />
                            <steps:Personalization DataContext="{Binding Personalization}" />
                            <steps:Notification DataContext="{Binding Notification}" />
                            <steps:Summary DataContext="{Binding Summary}" />
                        </Grid>
                    </customControls:FadingScrollViewer>
                </Grid>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        HorizontalAlignment="Left"
                        Click="OnBackClick"
                        Style="{StaticResource ActionButtonStyle}"
                        Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVisibilityInvertedConverter}}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <components:Icon
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Path="{StaticResource AngleLeft}"
                                Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Text="Back" />
                        </StackPanel>
                    </Button>

                    <customControls:StepNavigatorControl
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        CurrentStep="{Binding MiddleCurrentStep}"
                        StepCount="{Binding MiddleStepCount}" />

                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Click="OnNextClick"
                        IsEnabled="{Binding IsNextEnabled}"
                        Style="{StaticResource WizardFinishButtonStyle}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Text="Next" />
                            <components:Icon
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Path="{StaticResource AngleRight}"
                                Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>



