<UserControl
    x:Class="Fluxo.Views.Shell.Wizard.Pages.Steps.Personalization"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreEnums="clr-namespace:Fluxo.Core.Enums;assembly=Fluxo.Core"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources">
    <StackPanel>
        <Border Margin="0,0,0,12" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource Bold}" Foreground="{DynamicResource Brush.Text.Primary}" Text="Run with Windows" />
                        <TextBlock Margin="0,6,0,0" FontFamily="{StaticResource Medium}" Foreground="{DynamicResource Brush.Text.Secondary}" Text="Start fluxo in the system tray when Windows signs in." TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShouldRunAtStartup, Mode=TwoWay}" Style="{StaticResource ToggleSwitchStyle}" />
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="252" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Bold}" Foreground="{DynamicResource Brush.Text.Primary}" Text="When closing fluxo" />
                    <customControls:SegmentedToggleGroup Grid.Column="1">
                        <customControls:SegmentedToggleOption Command="{Binding SetCloseBehaviorCommand, Mode=OneWay}" CommandParameter="{x:Static coreEnums:AppCloseBehavior.MinimizeToTray}" Content="Minimize to tray" IsSelected="{Binding IsMinimizeToTrayCloseBehaviorSelected, Mode=OneWay}" SelectOnClick="False" />
                        <customControls:SegmentedToggleOption Command="{Binding SetCloseBehaviorCommand, Mode=OneWay}" CommandParameter="{x:Static coreEnums:AppCloseBehavior.Exit}" Content="Exit" IsSelected="{Binding IsExitCloseBehaviorSelected, Mode=OneWay}" SelectOnClick="False" />
                    </customControls:SegmentedToggleGroup>
                </Grid>
            </StackPanel>
        </Border>
        <Border Margin="0,0,0,12" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontFamily="{StaticResource Bold}"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="Lock UI when away" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontFamily="{StaticResource Medium}"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        Text="Lock fluxo after inactivity."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleButton
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsAppAutoLocked, Mode=TwoWay}"
                    Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border
            Margin="0,0,0,12"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{Binding HasAutoLockInterval, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <StackPanel>
                <TextBlock
                    FontFamily="{StaticResource Bold}"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="Auto-lock after" />
                <customControls:SegmentedToggleGroup Margin="0,10,0,0" SelectedValue="{Binding SelectedAppAutoLockPreset, Mode=TwoWay}">
                    <customControls:SegmentedToggleOption Content="30 seconds" Value="30" />
                    <customControls:SegmentedToggleOption Content="1 minute" Value="60" />
                    <customControls:SegmentedToggleOption Content="3 minutes" Value="180" />
                    <customControls:SegmentedToggleOption Content="5 minutes" Value="300" />
                    <customControls:SegmentedToggleOption Content="10 minutes" Value="600" />
                    <customControls:SegmentedToggleOption Content="Custom" Value="Custom" />
                </customControls:SegmentedToggleGroup>
                <StackPanel
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsCustomAutoLockInterval, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <customControls:NumericUpDown
                        Width="96"
                        LowerLimit="1"
                        Value="{Binding AppAutoLockedInterval, Mode=TwoWay}" />
                    <TextBox
                        Width="72"
                        Margin="8,0,0,0"
                        IsReadOnly="True"
                        Style="{StaticResource RoundedTextInputStyle}"
                        Text="seconds" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontFamily="{StaticResource Bold}"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="Unlock password" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontFamily="{StaticResource Medium}"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        Text="Used for manual locks and away locks."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Column="1" Width="260">
                    <PasswordBox
                        x:Name="UiLockingPasswordBox"
                        Padding="12,0,24,0"
                        PasswordChanged="OnUiLockingPasswordBoxPasswordChanged"
                        Style="{StaticResource RoundedPasswordInputStyle}"
                        Visibility="{Binding IsUiLockingPasswordVisible, Converter={StaticResource BoolToVisibilityInvertedConverter}, Mode=OneWay}" />
                    <TextBox
                        x:Name="UiLockingPasswordVisibleTextBox"
                        Padding="12,0,24,0"
                        Style="{StaticResource RoundedTextInputStyle}"
                        TextChanged="OnUiLockingPasswordVisibleTextBoxTextChanged"
                        Visibility="{Binding IsUiLockingPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <customControls:BalloonCheckBox
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CheckedBackground="Transparent"
                        CheckedIcon="{StaticResource Eye}"
                        CheckedText="Hide password"
                        DefaultBackground="{DynamicResource Brush.BalloonButton.Background.Neutral}"
                        HoveredBackground="{DynamicResource Brush.BalloonButton.Background.Neutral.Hovered}"
                        IconSize="12"
                        IsChecked="{Binding IsUiLockingPasswordVisible, Mode=TwoWay}"
                        UncheckedIcon="{StaticResource EyeOff}"
                        UncheckedText="Show password" />
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
