<UserControl
    x:Class="Fluxo.Views.Shell.Wizard.Pages.Steps.Summary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <UserControl.Resources>
        <Style x:Key="SummaryCaptionTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Medium}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <Style x:Key="SummaryMutedCaptionTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Medium}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        </Style>

        <Style x:Key="SummaryLabelTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>

        <Style x:Key="SummaryTotalTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Mint}" />
        </Style>
    </UserControl.Resources>
    <!--  Step 8: Report Summary  -->
    <StackPanel Visibility="{Binding IsStep8Active, Converter={StaticResource BoolToVisibilityConverter}}">
        <!--  Profile  -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock
                    FontFamily="{StaticResource Medium}"
                    FontSize="11"
                    Foreground="{DynamicResource Brush.Text.Muted}"
                    Text="Username" />
                <TextBlock Style="{StaticResource SummaryLabelTextStyle}"
                    Text="{Binding ReportUsernameText}" />
            </StackPanel>
        </Border>

        <!--  Accounts / Recurring Transactions / Savings Goals  -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource SummaryTotalTextStyle}"
                        Text="{Binding ReportAccountCount}" />
                    <TextBlock Style="{StaticResource SummaryCaptionTextStyle}"
                        Text="Accounts" />
                    <TextBlock Style="{StaticResource SummaryMutedCaptionTextStyle}"
                        Text="{Binding ReportTotalBalanceText}"
                        ToolTip="{Binding ReportTotalBalanceTooltipText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource Bold}"
                        FontSize="22"
                        Foreground="{DynamicResource Brush.Warning}"
                        Text="{Binding ReportRecurringTransactionCount}" />
                    <TextBlock Style="{StaticResource SummaryCaptionTextStyle}"
                        Text="Recurring Transactions" />
                    <TextBlock Style="{StaticResource SummaryMutedCaptionTextStyle}"
                        Text="{Binding ReportTotalRecurringTransactionText}"
                        ToolTip="{Binding ReportTotalRecurringTransactionTooltipText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource SummaryTotalTextStyle}"
                        Text="{Binding ReportSavingGoalCount}" />
                    <TextBlock Style="{StaticResource SummaryCaptionTextStyle}"
                        Text="Savings Goals" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Budget Allocation  -->
        <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock
                    FontFamily="{StaticResource Medium}"
                    FontSize="11"
                    Foreground="{DynamicResource Brush.Text.Muted}"
                    Text="Budget Allocation" />
                <TextBlock Style="{StaticResource SummaryLabelTextStyle}"
                    Text="{Binding ReportBudgetAllocationText}" />
            </StackPanel>
        </Border>

        <!--  Notifications  -->
        <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock
                    FontFamily="{StaticResource Medium}"
                    FontSize="11"
                    Foreground="{DynamicResource Brush.Text.Muted}"
                    Text="Notifications Enabled" />
                <TextBlock Style="{StaticResource SummaryLabelTextStyle}">
                    <Run Text="{Binding ReportNotificationsEnabledCount, Mode=OneWay}" />
                    <Run Text=" of 7" />
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
