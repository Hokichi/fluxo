<UserControl
    x:Class="Fluxo.Views.Shell.Wizard.Pages.Steps.BudgetAllocation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:enums="clr-namespace:Fluxo.Core.Enums;assembly=Fluxo.Core"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <UserControl.Resources>
        <Style x:Key="BudgetAllocationPercentTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Width" Value="56" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="BudgetAllocationValueTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{StaticResource Medium}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <Style x:Key="BudgetAllocationHeadingTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>
    </UserControl.Resources>
    <!--  Step 5: Budget Allocation  -->
    <StackPanel>
        <StackPanel Margin="0,0,0,20">
            <TextBlock FontFamily="{StaticResource Bold}" FontSize="22" Foreground="{DynamicResource Brush.Text.Primary}" Text="Budget allocation" />
            <TextBlock Margin="0,8,0,0" FontFamily="{StaticResource Medium}" Foreground="{DynamicResource Brush.Text.Secondary}" Text="Set the Needs, Wants, and Invest split for your budget." TextWrapping="Wrap" />
        </StackPanel>
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource BudgetAllocationHeadingTextStyle}"
                        Text="Needs" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource Minus}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Needs:-1" />
                        <TextBlock Style="{StaticResource BudgetAllocationPercentTextStyle}"
                            Text="{Binding NeedsAllocationPercentage, StringFormat={}{0}%, Mode=OneWay}" />
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource PlusSolid}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Needs:+1" />
                    </StackPanel>
                </Grid>
                <Slider
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource BudgetSliderStyle}"
                    TickFrequency="1"
                    Value="{Binding NeedsAllocationPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource BudgetAllocationValueTextStyle}"
                    Grid.Row="2"
                    Text="{Binding NeedsAllocationAmountText, Converter={StaticResource MoneyDisplayConverter}, Mode=OneWay}"
                    ToolTip="{Binding NeedsAllocationAmountText, Converter={StaticResource MoneyFullDisplayConverter}, Mode=OneWay}" />
            </Grid>
        </Border>
        <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource BudgetAllocationHeadingTextStyle}"
                        Text="Wants" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource Minus}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Wants:-1" />
                        <TextBlock Style="{StaticResource BudgetAllocationPercentTextStyle}"
                            Text="{Binding WantsAllocationPercentage, StringFormat={}{0}%, Mode=OneWay}" />
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource PlusSolid}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Wants:+1" />
                    </StackPanel>
                </Grid>
                <Slider
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource BudgetSliderStyle}"
                    TickFrequency="1"
                    Value="{Binding WantsAllocationPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource BudgetAllocationValueTextStyle}"
                    Grid.Row="2"
                    Text="{Binding WantsAllocationAmountText, Converter={StaticResource MoneyDisplayConverter}, Mode=OneWay}"
                    ToolTip="{Binding WantsAllocationAmountText, Converter={StaticResource MoneyFullDisplayConverter}, Mode=OneWay}" />
            </Grid>
        </Border>
        <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource BudgetAllocationHeadingTextStyle}"
                        Text="Invest" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource Minus}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Invest:-1" />
                        <TextBlock Style="{StaticResource BudgetAllocationPercentTextStyle}"
                            Text="{Binding InvestAllocationPercentage, StringFormat={}{0}%, Mode=OneWay}" />
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource PlusSolid}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Invest:+1" />
                    </StackPanel>
                </Grid>
                <Slider
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource BudgetSliderStyle}"
                    TickFrequency="1"
                    Value="{Binding InvestAllocationPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource BudgetAllocationValueTextStyle}"
                    Grid.Row="2"
                    Text="{Binding InvestAllocationAmountText, Converter={StaticResource MoneyDisplayConverter}, Mode=OneWay}"
                    ToolTip="{Binding InvestAllocationAmountText, Converter={StaticResource MoneyFullDisplayConverter}, Mode=OneWay}" />
            </Grid>
        </Border>

        <TextBlock
            Margin="0,8,0,0"
            FontFamily="{StaticResource Bold}"
            Foreground="{DynamicResource Brush.Danger}"
            Text="{Binding BudgetAllocationErrorMessage, Mode=OneWay}"
            Visibility="{Binding HasBudgetAllocationError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

    </StackPanel>
</UserControl>
