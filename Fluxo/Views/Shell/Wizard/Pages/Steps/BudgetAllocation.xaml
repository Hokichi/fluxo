<UserControl
    x:Class="Fluxo.Views.Shell.Wizard.Pages.Steps.BudgetAllocation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:enums="clr-namespace:Fluxo.Core.Enums;assembly=Fluxo.Core"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <!--  Step 5: Budget Allocation  -->
    <StackPanel>
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontFamily="{StaticResource Bold}"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="Needs" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource Minus}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Needs:-1" />
                        <TextBlock
                            Width="56"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Bold}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding NeedsAllocationPercentage, StringFormat={}{0}%, Mode=OneWay}"
                            TextAlignment="Center" />
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource PlusSolid}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Needs:+1" />
                    </StackPanel>
                </Grid>
                <Slider
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource BudgetSliderStyle}"
                    TickFrequency="1"
                    Value="{Binding NeedsAllocationPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource Medium}"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    Text="{Binding NeedsAllocationAmountText, Converter={StaticResource MoneyDisplayConverter}, Mode=OneWay}"
                    ToolTip="{Binding NeedsAllocationAmountText, Converter={StaticResource MoneyFullDisplayConverter}, Mode=OneWay}" />
            </Grid>
        </Border>
        <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontFamily="{StaticResource Bold}"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="Wants" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource Minus}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Wants:-1" />
                        <TextBlock
                            Width="56"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Bold}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding WantsAllocationPercentage, StringFormat={}{0}%, Mode=OneWay}"
                            TextAlignment="Center" />
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource PlusSolid}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Wants:+1" />
                    </StackPanel>
                </Grid>
                <Slider
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource BudgetSliderStyle}"
                    TickFrequency="1"
                    Value="{Binding WantsAllocationPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource Medium}"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    Text="{Binding WantsAllocationAmountText, Converter={StaticResource MoneyDisplayConverter}, Mode=OneWay}"
                    ToolTip="{Binding WantsAllocationAmountText, Converter={StaticResource MoneyFullDisplayConverter}, Mode=OneWay}" />
            </Grid>
        </Border>
        <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontFamily="{StaticResource Bold}"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="Invest" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource Minus}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Invest:-1" />
                        <TextBlock
                            Width="56"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Bold}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding InvestAllocationPercentage, StringFormat={}{0}%, Mode=OneWay}"
                            TextAlignment="Center" />
                        <customControls:BalloonButton
                            ButtonIcon="{StaticResource PlusSolid}"
                            Click="OnAllocationAdjustButtonClick"
                            MouseLeave="OnAllocationAdjustButtonMouseLeave"
                            PreviewMouseLeftButtonDown="OnAllocationAdjustButtonMouseDown"
                            PreviewMouseLeftButtonUp="OnAllocationAdjustButtonMouseUp"
                            Style="{StaticResource StepperButtonStyle}"
                            Tag="Invest:+1" />
                    </StackPanel>
                </Grid>
                <Slider
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource BudgetSliderStyle}"
                    TickFrequency="1"
                    Value="{Binding InvestAllocationPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource Medium}"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    Text="{Binding InvestAllocationAmountText, Converter={StaticResource MoneyDisplayConverter}, Mode=OneWay}"
                    ToolTip="{Binding InvestAllocationAmountText, Converter={StaticResource MoneyFullDisplayConverter}, Mode=OneWay}" />
            </Grid>
        </Border>

        <TextBlock
            Margin="0,8,0,0"
            FontFamily="{StaticResource Bold}"
            Foreground="{DynamicResource Brush.Danger}"
            Text="{Binding BudgetAllocationErrorMessage, Mode=OneWay}"
            Visibility="{Binding HasBudgetAllocationError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

    </StackPanel>
</UserControl>
