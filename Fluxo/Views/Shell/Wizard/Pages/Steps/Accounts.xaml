<UserControl
    x:Class="Fluxo.Views.Shell.Wizard.Pages.Steps.Accounts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources">
    <UserControl.Resources>
        <DataTemplate x:Key="WizardAccountsItemTemplate">
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <customControls:BalloonButton Click="OnEditAccountClick" Style="{StaticResource EditButton}"
                            DefaultBackground="{DynamicResource Brush.BalloonButton.Background.Surface}"
                            HoveredBackground="{DynamicResource Brush.BalloonButton.Background.Surface.Hovered}" />
                        <customControls:BalloonButton Click="OnDeleteAccountClick" Style="{StaticResource DeleteButton}"
                            DefaultBackground="{DynamicResource Brush.BalloonButton.Background.Destructive}"
                            HoveredBackground="{DynamicResource Brush.BalloonButton.Background.Destructive.Hovered}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock
                            FontFamily="{StaticResource Bold}"
                            FontSize="15"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Name, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontFamily="{StaticResource Medium}"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            Text="{Binding TypeLabel, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,12,0,0"
                            FontFamily="{StaticResource Bold}"
                            Foreground="{DynamicResource Brush.Mint}"
                            ToolTip="{Binding PrimaryAmount, Converter={StaticResource MoneyFullDisplayConverter}, Mode=OneWay}">
                            <Run Text="{Binding PrimaryAmountLabel, Mode=OneWay}" />
                            <Run Text=": " />
                            <Run Text="{Binding PrimaryAmount, Converter={StaticResource NumberWithCommasConverter}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Margin="0,0,0,8" FontFamily="{StaticResource Bold}" FontSize="22" Foreground="{DynamicResource Brush.Text.Primary}" Text="Accounts" />
        <TextBlock Margin="0,0,0,16" FontFamily="{StaticResource Medium}" Foreground="{DynamicResource Brush.Text.Secondary}" Text="Add accounts now, or do it later from Settings." TextWrapping="Wrap" />
        <Border Margin="0,0,0,16" Padding="16" Background="{DynamicResource Brush.BalloonButton.Background.Caution}" CornerRadius="8" Visibility="{Binding HasFunctionalAccount, Converter={StaticResource BoolToVisibilityInvertedConverter}, Mode=OneWay}">
            <TextBlock FontFamily="{StaticResource Medium}" Foreground="{DynamicResource Brush.Text.Primary}" Text="fluxo works best with at least one functional account. You can continue and add one later." TextWrapping="Wrap" />
        </Border>
        <Button Margin="0,0,0,16" Click="OnAddAccountClick" Content="Add account" HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}" />
        <ItemsControl
            ItemContainerStyle="{StaticResource WizardItemContainerStyle}"
            ItemTemplate="{StaticResource WizardAccountsItemTemplate}"
            ItemsPanel="{StaticResource WizardItemsPanelTemplate}"
            ItemsSource="{Binding Accounts, Mode=OneWay}" />
    </StackPanel>

</UserControl>




