<UserControl
    x:Class="Fluxo.Views.Shell.Wizard.Pages.QuickSetupWizardBudgetIntroductionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource Bold}" FontSize="22" Foreground="{DynamicResource Brush.Text.Primary}" Text="Now let's set up your budget" />
            <TextBlock Margin="0,8,0,0" FontFamily="{StaticResource Medium}" Foreground="{DynamicResource Brush.Text.Secondary}" Text="Start with a simple split, then choose how fluxo should manage it." TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
