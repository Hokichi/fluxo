<Window
    x:Class="Fluxo.Views.Shell.StartupLoaderPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    Width="340"
    Height="220"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/Fluxo.Resources;component/Resources/fluxo.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Grid>

        <Border
            Padding="28"
            Background="{DynamicResource Brush.Background.Popup}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="22">
            <StackPanel VerticalAlignment="Center">
                <Border
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Background.Elevated}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="36">

                    <Rectangle
                        Width="36"
                        Height="36"
                        Fill="{StaticResource Brush.Mint}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Fluxo.Resources;component/Resources/fluxo.ico" Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Border>

                <StackPanel
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontFamily="{StaticResource Bold}"
                        FontSize="24"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="flux" />
                    <TextBlock
                        FontFamily="{StaticResource Bold}"
                        FontSize="24"
                        Foreground="{DynamicResource Brush.Mint}"
                        Text="o" />
                </StackPanel>
            </StackPanel>
        </Border>

        <components:FluxoWave Margin="0,160,0,0" ClipToBounds="True" />
    </Grid>
</Window>