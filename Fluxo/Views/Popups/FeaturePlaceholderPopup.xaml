<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.FeaturePlaceholderPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
>

    <Border Padding="24,8,24,24">
        <StackPanel Width="360">
            <TextBlock
                FontFamily="{StaticResource Bold}"
                FontSize="14"
                Foreground="{DynamicResource Brush.Text.Primary}"
                Text="{Binding PlaceholderTitle}"
                TextWrapping="Wrap" />

            <TextBlock
                Margin="0,12,0,0"
                FontFamily="{StaticResource Medium}"
                FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="{Binding PlaceholderMessage}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</customControls:BasePopup>



