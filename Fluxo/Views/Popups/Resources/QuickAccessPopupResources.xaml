<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources">

    <Style
        x:Key="QuickAccessEditBalloonButtonStyle"
        BasedOn="{StaticResource ToolbarActionBalloonButtonStyle}"
        TargetType="{x:Type customControls:BalloonButton}">
        <Setter Property="ButtonSize" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="ShouldShowText" Value="True" />
    </Style>

    <Style
        x:Key="QuickAccessTileTitleStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Bold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="QuickAccessTileDescriptionStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource Medium}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="QuickAccessHiddenTextStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Bold}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>

    <Style
        x:Key="QuickAccessEmptyStateTextStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Medium}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="QuickAccessTileButtonStyle"
        BasedOn="{StaticResource BaseButtonStyle}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="112" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="TileBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="QuickAccessTileTemplate">
        <Button
            AutomationProperties.HelpText="{Binding AutomationHelpText, Mode=OneWay}"
            AutomationProperties.Name="{Binding Title, Mode=OneWay}"
            IsEnabled="{Binding IsActionEnabled, Mode=OneWay}"
            Opacity="{Binding PresentationOpacity, Mode=OneWay}"
            Style="{StaticResource QuickAccessTileButtonStyle}"
            Visibility="{Binding IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <components:Icon
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Color="{DynamicResource Brush.Mint}"
                    Path="{Binding Icon, Mode=OneWay}" />
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource QuickAccessTileTitleStyle}" Text="{Binding Title, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource QuickAccessTileDescriptionStyle}" Text="{Binding Description, Mode=OneWay}" />
                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding IsHiddenIndicatorVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <components:Icon
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Color="{DynamicResource Brush.Text.Muted}"
                            Path="{StaticResource EyeOff}" />
                        <TextBlock Style="{StaticResource QuickAccessHiddenTextStyle}" Text="Hidden" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="QuickAccessRowItemsPanelTemplate">
        <customControls:SpacedUniformGrid Columns="3" HorizontalGap="16" />
    </ItemsPanelTemplate>

    <Style
        x:Key="QuickAccessRowItemsControlStyle"
        BasedOn="{StaticResource BaseItemsControlStyle}"
        TargetType="ItemsControl">
        <Setter Property="ItemTemplate" Value="{StaticResource QuickAccessTileTemplate}" />
        <Setter Property="ItemsPanel" Value="{StaticResource QuickAccessRowItemsPanelTemplate}" />
    </Style>

    <DataTemplate x:Key="QuickAccessRowTemplate">
        <ItemsControl
            ItemsSource="{Binding Mode=OneWay}"
            Style="{StaticResource QuickAccessRowItemsControlStyle}" />
    </DataTemplate>

    <Style
        x:Key="QuickAccessRowContainerStyle"
        BasedOn="{StaticResource BaseContentPresenterStyle}"
        TargetType="ContentPresenter">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <ItemsPanelTemplate x:Key="QuickAccessRowsItemsPanelTemplate">
        <VirtualizingStackPanel />
    </ItemsPanelTemplate>

    <Style
        x:Key="QuickAccessRowsItemsControlStyle"
        BasedOn="{StaticResource BaseItemsControlStyle}"
        TargetType="ItemsControl">
        <Setter Property="MaxHeight" Value="384" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource QuickAccessRowContainerStyle}" />
        <Setter Property="ItemTemplate" Value="{StaticResource QuickAccessRowTemplate}" />
        <Setter Property="ItemsPanel" Value="{StaticResource QuickAccessRowsItemsPanelTemplate}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer
                        CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                        Focusable="False"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
