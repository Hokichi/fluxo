<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.AddTagPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    Width="520"
    PopupTitle="{Binding PopupTitle}"
    Mode="Modify">

    <customControls:BasePopup.Resources>
        <Style x:Key="ColorSelectorListBoxStyle" BasedOn="{StaticResource BaseListBoxStyle}" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style BasedOn="{StaticResource BaseListBoxItemStyle}" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,10,10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="ColorChip"
                                        Width="30"
                                        Height="30"
                                        Background="{Binding HexCode}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="15">
                                        <components:Icon
                                            x:Name="TickPath"
                                            Margin="8"
                                            Opacity="0"
                                            Path="{StaticResource Check}">
                                            <components:Icon.Color>
                                                <Binding
                                                    ElementName="ColorChip"
                                                    Path="Background"
                                                    Converter="{StaticResource BackgroundToForegroundConverter}" />
                                            </components:Icon.Color>
                                        </components:Icon>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ColorChip" Property="BorderBrush" Value="{StaticResource Brush.Text.Primary}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ColorChip" Property="BorderBrush" Value="{StaticResource Brush.Text.Primary}" />
                                            <Setter TargetName="ColorChip" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="TickPath" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel" Value="{StaticResource PopupWrapItemsPanelTemplate}" />
        </Style>
    </customControls:BasePopup.Resources>

    <Grid Margin="24,0,24,24">
        <StackPanel>
                <TextBlock Style="{StaticResource PopupFieldLabelStyle}" Text="Tag Name" />
                <TextBox
                    x:Name="TagNameTextBox"
                    Style="{StaticResource RoundedTextInputStyle}"
                    Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="0,14,0,8"
                    Style="{StaticResource PopupFieldLabelStyle}"
                    Text="Spending Limit" />
                <TextBox
                    Style="{StaticResource RoundedTextInputStyle}"
                    Text="{Binding SpendingLimitText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="0,14,0,8"
                    Style="{StaticResource PopupFieldLabelStyle}"
                    Text="Color" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox
                        Grid.Column="0"
                        ItemsSource="{Binding ColorOptions}"
                        SelectedValue="{Binding SelectedColorHex, Mode=TwoWay}"
                        SelectedValuePath="HexCode"
                        Style="{StaticResource ColorSelectorListBoxStyle}" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Click="OnAddCustomColorClick"
                        Style="{StaticResource CustomColorButtonStyle}"
                        ToolTip="Custom color" />
                </Grid>
        </StackPanel>
    </Grid>
</customControls:BasePopup>



