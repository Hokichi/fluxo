<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.AddTagPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    Width="520"
    PopupTitle="{Binding PopupTitle}"
    Mode="Modify">

    <customControls:BasePopup.Resources>
<ControlTemplate x:Key="CustomColorButtonTemplate" TargetType="Button">
                    <Grid
                        Width="30"
                        Height="30"
                        Background="Transparent">
                        <Ellipse
                            Stroke="{TemplateBinding BorderBrush}"
                            StrokeDashArray="2,2"
                            StrokeThickness="{TemplateBinding BorderThickness}" />
                        <components:Icon
                            x:Name="Plus"
                            Margin="9"
                            Path="{StaticResource PlusSolid}"
                            Color="{DynamicResource Brush.Text.Muted}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter TargetName="Plus" Property="Color" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

<Style x:Key="CustomColorButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource CustomColorButtonTemplate}" />
    </Style>
                <ControlTemplate x:Key="ColorSelectorListBoxTemplate" TargetType="ListBoxItem">
                                            <Border
                                                x:Name="ColorChip"
                                                Width="30"
                                                Height="30"
                                                Background="{Binding HexCode}"
                                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="15">
                                                <components:Icon
                                                    x:Name="TickPath"
                                                    Margin="8"
                                                    Opacity="0"
                                                    Path="{StaticResource Check}">
                                                    <components:Icon.Color>
                                                        <Binding
                                                            ElementName="ColorChip"
                                                            Path="Background"
                                                            Converter="{StaticResource BackgroundToForegroundConverter}" />
                                                    </components:Icon.Color>
                                                </components:Icon>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ColorChip" Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ColorChip" Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                                                    <Setter TargetName="ColorChip" Property="BorderThickness" Value="2" />
                                                    <Setter TargetName="TickPath" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>

        <Style x:Key="ColorSelectorListBoxItemStyle" BasedOn="{StaticResource BaseListBoxItemStyle}" TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Template" Value="{StaticResource ColorSelectorListBoxTemplate}" />
                            </Style>

<Style x:Key="ColorSelectorListBoxStyle" BasedOn="{StaticResource BaseListBoxStyle}" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ColorSelectorListBoxItemStyle}" />
            <Setter Property="ItemsPanel" Value="{StaticResource PopupWrapItemsPanelTemplate}" />
        </Style>
    </customControls:BasePopup.Resources>

    <Grid Margin="24,0,24,24">
        <StackPanel>
                <TextBlock Style="{StaticResource PopupFieldLabelStyle}" Text="Tag Name" />
                <TextBox
                    x:Name="TagNameTextBox"
                    Style="{StaticResource RoundedTextInputStyle}"
                    Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="0,14,0,8"
                    Style="{StaticResource PopupFieldLabelStyle}"
                    Text="Spending Limit" />
                <TextBox
                    Style="{StaticResource RoundedTextInputStyle}"
                    Text="{Binding SpendingLimitText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="0,14,0,8"
                    Style="{StaticResource PopupFieldLabelStyle}"
                    Text="Color" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox
                        Grid.Column="0"
                        ItemsSource="{Binding ColorOptions}"
                        SelectedValue="{Binding SelectedColorHex, Mode=TwoWay}"
                        SelectedValuePath="HexCode"
                        Style="{StaticResource ColorSelectorListBoxStyle}" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Click="OnAddCustomColorClick"
                        Style="{StaticResource CustomColorButtonStyle}"
                        ToolTip="Custom color" />
                </Grid>
        </StackPanel>
    </Grid>
</customControls:BasePopup>


