<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.HotkeysOverviewPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    PopupTitle="Hotkeys Overview">

<customControls:BasePopup.Resources>
                <ControlTemplate x:Key="HotkeyExpanderToggleButtonTemplate" TargetType="ToggleButton">
                                                <Border
                                                    x:Name="ExpanderHeaderContent"
                                                    Padding="10,8"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path
                                                            x:Name="ExpanderIcon"
                                                            Width="10"
                                                            Height="10"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource AngleRight}"
                                                            Stretch="Uniform">
                                                            <Path.Fill>
                                                                <SolidColorBrush x:Name="ExpanderIconBrush" Color="{DynamicResource Color.Text.Primary}" />
                                                            </Path.Fill>
                                                        </Path>
                                                        <TextBlock
                                                            x:Name="ExpanderHeaderText"
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource Bold}"
                                                            FontSize="13"
                                                            Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}">
                                                            <TextBlock.Foreground>
                                                                <SolidColorBrush x:Name="ExpanderHeaderTextBrush" Color="{DynamicResource Color.Text.Primary}" />
                                                            </TextBlock.Foreground>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ExpanderIcon" Property="Data" Value="{StaticResource AngleDown}" />
                                                    </Trigger>
                                                    <Trigger SourceName="ExpanderHeaderContent" Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation
                                                                        Storyboard.TargetName="ExpanderIconBrush"
                                                                        Storyboard.TargetProperty="Color"
                                                                        To="{DynamicResource Color.Mint}"
                                                                        Duration="0:0:0.14" />
                                                                    <ColorAnimation
                                                                        Storyboard.TargetName="ExpanderHeaderTextBrush"
                                                                        Storyboard.TargetProperty="Color"
                                                                        To="{DynamicResource Color.Mint}"
                                                                        Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation
                                                                        Storyboard.TargetName="ExpanderIconBrush"
                                                                        Storyboard.TargetProperty="Color"
                                                                        To="{DynamicResource Color.Text.Primary}"
                                                                        Duration="0:0:0.14" />
                                                                    <ColorAnimation
                                                                        Storyboard.TargetName="ExpanderHeaderTextBrush"
                                                                        Storyboard.TargetProperty="Color"
                                                                        To="{DynamicResource Color.Text.Primary}"
                                                                        Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>

        <ControlTemplate x:Key="HotkeyExpanderTemplate" TargetType="Expander">
                                <StackPanel>
                                    <ToggleButton
                                        x:Name="HeaderSite"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}"
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                                                                <StaticResource ResourceKey="HotkeyExpanderToggleButtonTemplate" />
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter
                                        x:Name="ExpandSite"
                                        ContentSource="Content"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>

<Style x:Key="HotkeyExpanderStyle" BasedOn="{StaticResource BaseExpanderStyle}" TargetType="Expander">
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Template" Value="{StaticResource HotkeyExpanderTemplate}" />
        </Style>

        <Style x:Key="HotkeyRowStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="HotkeyItemContainerStyle" BasedOn="{StaticResource BaseContentPresenterStyle}" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>

        <Style x:Key="HotkeyFunctionalityTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Medium}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HotkeyPartTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="HotkeyPartTemplate">
            <Border
                Margin="4,0,0,0"
                Padding="8,4"
                Background="{DynamicResource Brush.Background.Elevated}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock
                    MinWidth="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Bold}"
                    FontSize="11"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="{Binding Text}"
                    TextAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HotkeyItemTemplate">
            <Border x:Name="HotkeyItemBorder" Style="{StaticResource HotkeyRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource HotkeyFunctionalityTextStyle}" Text="{Binding Functionality}" />
                    <ItemsControl
                        Grid.Column="2"
                        ItemTemplate="{StaticResource HotkeyPartTemplate}"
                        ItemsPanel="{StaticResource HorizontalStackItemsPanelTemplate}"
                        ItemsSource="{Binding Parts}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="HotkeyItemBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HotkeyItemBorder" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                    <Setter TargetName="HotkeyItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Mint}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="HotkeyGroupTemplate">
            <Expander Header="{Binding Name}" Style="{StaticResource HotkeyExpanderStyle}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl
                        ItemContainerStyle="{StaticResource HotkeyItemContainerStyle}"
                        ItemTemplate="{StaticResource HotkeyItemTemplate}"
                        ItemsSource="{Binding LeftHotkeys}" />
                    <ItemsControl
                        Grid.Column="1"
                        ItemContainerStyle="{StaticResource HotkeyItemContainerStyle}"
                        ItemTemplate="{StaticResource HotkeyItemTemplate}"
                        ItemsSource="{Binding RightHotkeys}" />
                </Grid>
            </Expander>
        </DataTemplate>

<ItemsPanelTemplate x:Key="HotkeyGroupItemsPanelTemplate">
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
</customControls:BasePopup.Resources>

    <Border Width="760" Padding="32,6,32,28">
        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
<ItemsControl ItemTemplate="{StaticResource HotkeyGroupTemplate}" ItemsSource="{Binding HotkeyGroups}" ItemsPanel="{StaticResource HotkeyGroupItemsPanelTemplate}">

            </ItemsControl>
        </ScrollViewer>
    </Border>
</customControls:BasePopup>
