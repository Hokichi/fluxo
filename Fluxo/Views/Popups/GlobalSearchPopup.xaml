<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.GlobalSearchPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    Mode="None"
    PopupTitle="Search">
    <customControls:BasePopup.Resources>
        <ItemsPanelTemplate x:Key="GlobalSearchTypeItemsPanelTemplate">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <Style
            x:Key="GlobalSearchTypeListBoxStyle"
            BasedOn="{StaticResource BaseListBoxStyle}"
            TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style
            x:Key="GlobalSearchTypeListBoxItemStyle"
            BasedOn="{StaticResource BaseListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="GlobalSearchTypePillRadioStyle"
            BasedOn="{StaticResource BaseRadioButtonStyle}"
            TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="PillBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Content}" />
                                <components:Icon
                                    x:Name="SelectedCheck"
                                    Width="10"
                                    Height="10"
                                    Margin="6,0,0,0"
                                    Path="{StaticResource Check}"
                                    Visibility="Collapsed"
                                    Color="{DynamicResource Brush.Mint}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource Brush.Mint.Tint}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource Brush.Mint}" />
                                <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="GlobalSearchTypePillTemplate">
            <RadioButton
                AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                Content="{Binding Name, Mode=OneWay}"
                IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}"
                Style="{StaticResource GlobalSearchTypePillRadioStyle}" />
        </DataTemplate>
        <Style
            x:Key="GlobalSearchResultIconStyle"
            BasedOn="{StaticResource BaseIconStyle}"
            TargetType="components:Icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Color" Value="{DynamicResource Brush.Text.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="Transactions">
                    <Setter Property="Path" Value="{StaticResource BanknoteArrowDown}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="Accounts">
                    <Setter Property="Path" Value="{StaticResource BookDollar}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="Tags">
                    <Setter Property="Path" Value="{StaticResource SolidPriceTagAlt}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="Goals">
                    <Setter Property="Path" Value="{StaticResource BullseyeSolid}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="Features">
                    <Setter Property="Path" Value="{StaticResource Cog}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="Settings">
                    <Setter Property="Path" Value="{StaticResource Cog}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="GlobalSearchResultItemTemplate">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <components:Icon VerticalAlignment="Center" Style="{StaticResource GlobalSearchResultIconStyle}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Bold}"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="{Binding Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Medium}"
                    FontSize="11"
                    Foreground="{DynamicResource Brush.Text.Muted}"
                    Text="{Binding SecondaryText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <Style
            x:Key="GlobalSearchResultItemContainerStyle"
            BasedOn="{StaticResource BaseListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Mint.Tint}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Mint}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="GlobalSearchResultsListBoxStyle"
            BasedOn="{StaticResource BaseListBoxStyle}"
            TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style
            x:Key="GlobalSearchStateTextStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Medium}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </customControls:BasePopup.Resources>
    <Grid Width="720" Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox
            x:Name="QueryTextBox"
            AutomationProperties.Name="Search everything"
            IsEnabled="False"
            Style="{StaticResource RoundedTextInputStyle}"
            TextChanged="OnQueryTextChanged" />
        <Grid Grid.Row="2">
            <Grid x:Name="ResultContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListBox
                    x:Name="ResultTypesListBox"
                    AutomationProperties.Name="Result type"
                    ItemContainerStyle="{StaticResource GlobalSearchTypeListBoxItemStyle}"
                    ItemTemplate="{StaticResource GlobalSearchTypePillTemplate}"
                    ItemsPanel="{StaticResource GlobalSearchTypeItemsPanelTemplate}"
                    SelectionChanged="OnResultTypeSelectionChanged"
                    SelectionMode="Single"
                    Style="{StaticResource GlobalSearchTypeListBoxStyle}" />
                <TextBlock
                    x:Name="SelectedTypeText"
                    Grid.Row="2"
                    FontFamily="{StaticResource Bold}"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.Text.Secondary}" />
                <ListBox
                    x:Name="ResultsListBox"
                    Grid.Row="4"
                    AutomationProperties.Name="Search results"
                    ItemContainerStyle="{StaticResource GlobalSearchResultItemContainerStyle}"
                    ItemTemplate="{StaticResource GlobalSearchResultItemTemplate}"
                    MouseLeftButtonUp="OnResultMouseLeftButtonUp"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Style="{StaticResource GlobalSearchResultsListBoxStyle}" />
            </Grid>
            <TextBlock
                x:Name="StateText"
                IsHitTestVisible="False"
                Style="{StaticResource GlobalSearchStateTextStyle}" />
        </Grid>
    </Grid>
</customControls:BasePopup>
