<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.AddTagColorPickerPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    Width="460"
    PopupTitle="Custom Tag Color">

<customControls:BasePopup.Resources>

<ControlTemplate TargetType="Thumb" x:Key="HueSliderThumbTemplate">
                                                    <Border
                                                        Background="{StaticResource Brush.Background.Surface}"
                                                        BorderBrush="{StaticResource Brush.Text.Primary}"
                                                        BorderThickness="1"
                                                        CornerRadius="4" />
                                                </ControlTemplate>

<ControlTemplate TargetType="Slider" x:Key="HueSliderTemplate">
                            <Grid>
                                <Border Margin="5,0" CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0" Color="#FFFF0000" />
                                            <GradientStop Offset="0.17" Color="#FFFFFF00" />
                                            <GradientStop Offset="0.33" Color="#FF00FF00" />
                                            <GradientStop Offset="0.5" Color="#FF00FFFF" />
                                            <GradientStop Offset="0.67" Color="#FF0000FF" />
                                            <GradientStop Offset="0.83" Color="#FFFF00FF" />
                                            <GradientStop Offset="1" Color="#FFFF0000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Track
                                    x:Name="PART_Track"
                                    IsDirectionReversed="True"
                                    Orientation="Vertical">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            Command="Slider.DecreaseLarge"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
<Thumb Width="18" Height="8" Template="{StaticResource HueSliderThumbTemplate}">

                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            Command="Slider.IncreaseLarge"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
</customControls:BasePopup.Resources>

    <Grid Margin="24,0,24,24">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="SaturationValueSurface"
                    Grid.Column="0"
                    Height="200"
                    MouseDown="OnSaturationSurfaceMouseDown"
                    MouseMove="OnSaturationSurfaceMouseMove"
                    MouseUp="OnSaturationSurfaceMouseUp"
                    PreviewMouseLeftButtonDown="OnSaturationSurfaceMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="OnSaturationSurfaceMouseLeftButtonUp">
                    <Grid>
                        <Border x:Name="HuePreviewSurface" CornerRadius="10" />
                        <Rectangle RadiusX="10" RadiusY="10">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                                    <GradientStop Offset="1" Color="#00FFFFFF" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle RadiusX="10" RadiusY="10">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Offset="0" Color="#00FFFFFF" />
                                    <GradientStop Offset="1" Color="#FF000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas ClipToBounds="True">
                            <Ellipse
                                x:Name="ColorHandle"
                                Width="14"
                                Height="14"
                                Stroke="{StaticResource Brush.Background.Surface}"
                                StrokeThickness="2" />
                        </Canvas>
                    </Grid>
                </Border>

<Slider
                    x:Name="HueSlider"
                    Grid.Column="2"
                    Width="20"
                    Maximum="360"
                    Minimum="0"
                    Orientation="Vertical"
                    TickFrequency="1"
                    ValueChanged="OnHueSliderValueChanged" Template="{StaticResource HueSliderTemplate}">

                </Slider>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="36"
                    Height="36"
                    Background="{Binding ElementName=HexCodeTextBox, Path=Text, UpdateSourceTrigger=Explicit}"
                    CornerRadius="8" />

                <TextBox
                    x:Name="HexCodeTextBox"
                    Grid.Column="2"
                    Style="{StaticResource RoundedTextInputStyle}"
                    TextChanged="OnHexCodeTextChanged" />
            </Grid>

            <StackPanel
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Click="OnCancelClick"
                    Content="Cancel"
                    Style="{StaticResource ActionTextButtonStyle}" />
                <Button
                    Margin="8,0,0,0"
                    Click="OnConfirmClick"
                    Content="Confirm"
                    Style="{StaticResource ActionTextButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</customControls:BasePopup>
