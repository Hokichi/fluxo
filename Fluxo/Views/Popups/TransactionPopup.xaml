<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.TransactionPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Fluxo.Resources.Behaviors;assembly=Fluxo.Resources"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataEnums="clr-namespace:Fluxo.Data.Enums;assembly=Fluxo.Data"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:popups="clr-namespace:Fluxo.ViewModels.Popups"
    CanClone="{Binding CanCloneViewedTransaction, Mode=OneWay}"
    CanContinue="{Binding CanContinue, Mode=OneWay}"
    CanDelete="{Binding CanDeleteViewedTransaction, Mode=OneWay}"
    CanDiscard="{Binding CanDiscard, Mode=OneWay}"
    CanEdit="{Binding CanEditViewedTransaction, Mode=OneWay}"
    CanSkip="{Binding CanSkipProcessing, Mode=OneWay}"
    CurrentStep="{Binding CurrentProcessingStep, Mode=OneWay}"
    IsSaveAndCreateNewButtonEnabled="{Binding CanSave, Mode=OneWay}"
    IsSaveButtonEnabled="{Binding CanSave, Mode=OneWay}"
    Mode="{Binding PopupMode, Mode=OneWay}"
    PopupTitle="{Binding PopupTitle, Mode=OneWay}"
    StepCount="{Binding ProcessingStepCount, Mode=OneWay}"
    mc:Ignorable="d">

    <customControls:BasePopup.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fluxo;component/Resources/Styles/TransactionSplitTreeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            </Style>

            <Style x:Key="FieldHeaderGridStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="TransactionWarningTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Medium}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWarning, Mode=OneWay}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PopupFieldBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="PopupTagListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style x:Key="PopupTagListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="PopupOtherTagListBoxItemStyle"
                BasedOn="{StaticResource PopupTagListBoxItemStyle}"
                TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>

            <DataTemplate x:Key="PopupTagTemplate">
                <RadioButton
                    Content="{Binding Name, Mode=OneWay}"
                    GroupName="AddNewTransactionTags"
                    IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}"
                    Style="{StaticResource PopupTagItemRadioStyle}" />
            </DataTemplate>

            <ItemsPanelTemplate x:Key="PopupVisibleTagsItemsPanelTemplate">
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>

            <ItemsPanelTemplate x:Key="PopupOverflowTagsItemsPanelTemplate">
                <WrapPanel />
            </ItemsPanelTemplate>

            <Style x:Key="TransactionNameSuggestionListBoxStyle" TargetType="ListBox">
                <Setter Property="MinWidth" Value="260" />
                <Setter Property="MaxHeight" Value="220" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>

            <Style x:Key="TransactionNameSuggestionListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="ItemBackground"
                                Padding="8,6"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TransactionHistoryListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style x:Key="TransactionHistoryListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="ItemBackground"
                                Padding="10,8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource Brush.Border.Accent.Muted}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="TransactionHistoryItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="8"
                        Height="8"
                        Margin="0,5,10,0"
                        VerticalAlignment="Top"
                        Fill="{Binding TagHexCode, FallbackValue={StaticResource Brush.Mint}, TargetNullValue={StaticResource Brush.Mint}, Mode=OneWay}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontFamily="{DynamicResource Bold}"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontFamily="{DynamicResource Regular}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding AccountName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="{DynamicResource Bold}"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Amount, StringFormat={}{0:N2}, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,3,0,0"
                            HorizontalAlignment="Right"
                            FontFamily="{DynamicResource Regular}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding Date, Converter={StaticResource DateTimeToRelativeDateConverter}, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ChildTransactionItemTemplate">
                <Border
                    Margin="0,0,0,10"
                    Padding="16"
                    Background="{DynamicResource Brush.Background.Elevated}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontFamily="{DynamicResource Bold}"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                Text="{Binding Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                FontFamily="{DynamicResource Bold}"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.Danger}"
                                Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            FontFamily="{DynamicResource Medium}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding OccurredOn, Mode=OneWay, StringFormat={}{0:MMM d, yyyy}}" />

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                            <Border
                                MaxWidth="96"
                                Padding="8,2"
                                Background="{Binding TagHexCode, Mode=OneWay}"
                                CornerRadius="8">
                                <TextBlock
                                    FontFamily="{DynamicResource Bold}"
                                    FontSize="10"
                                    Text="{Binding TagName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Foreground>
                                        <Binding
                                            Converter="{StaticResource ForegroundForBackgroundBrushConverter}"
                                            ConverterParameter="{StaticResource Brush.Text.Primary}"
                                            Path="Background"
                                            RelativeSource="{RelativeSource AncestorType=Border}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                            <TextBlock
                                Margin="8,2,0,0"
                                FontFamily="{DynamicResource Medium}"
                                FontSize="10"
                                Foreground="{DynamicResource Brush.Text.Muted}"
                                Text="{Binding CategoryLabel, Mode=OneWay}" />
                        </StackPanel>
                        <Path
                            Grid.Row="2"
                            Width="13"
                            Height="13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Data="{StaticResource CreditCardMinusSolid}"
                            Fill="{DynamicResource Brush.Info}"
                            Stretch="Uniform"
                            ToolTip="Lend"
                            Visibility="{Binding IsIoU, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <Style
                x:Key="ExpenseCategoryComboBoxItemStyle"
                BasedOn="{StaticResource FluxoComboBoxItemStyle}"
                TargetType="ComboBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsEnabled, Mode=OneWay}" />
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsEnabled, Mode=OneWay}" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="TransactionNameSuggestionTemplate">
                <Grid Width="320" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontFamily="{DynamicResource Bold}"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontFamily="{DynamicResource Regular}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding AccountName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Bold}"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding Amount, StringFormat={}{0:N2}, Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TransactionWarningTemplate">
                <TextBlock Style="{StaticResource TransactionWarningTextStyle}" Text="{Binding Message, Mode=OneWay}" />
            </DataTemplate>

        </ResourceDictionary>
    </customControls:BasePopup.Resources>

    <Border Padding="20,4,20,20">
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsViewOnly, Mode=OneWay}" Value="True">
                            <Setter Property="Focusable" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="720" />
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="20" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSidePanel, Mode=OneWay}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <customControls:SegmentedToggleGroup
                    Width="520"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding CanChangeTransactionType, Mode=OneWay}">
                    <customControls:SegmentedToggleOption
                        x:Name="ExpenseRadioButton"
                        Content="Expense"
                        IsSelected="{Binding IsExpense, Mode=TwoWay}" />
                    <customControls:SegmentedToggleOption
                        x:Name="IncomeRadioButton"
                        Content="Income"
                        IsSelected="{Binding IsIncome, Mode=TwoWay}" />
                    <customControls:SegmentedToggleOption
                        x:Name="GoalRadioButton"
                        Content="Goal Update"
                        IsSelected="{Binding IsGoal, Mode=TwoWay}" />
                    <customControls:SegmentedToggleOption
                        x:Name="RepaymentRadioButton"
                        Content="Repayment"
                        IsSelected="{Binding IsRepayment, Mode=TwoWay}" />
                </customControls:SegmentedToggleGroup>
            </StackPanel>

            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel>
                        <Grid Style="{StaticResource FieldHeaderGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0"
                                Style="{StaticResource SectionLabelStyle}"
                                Text="Name" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="ExpenseNameTextBox"
                                GotKeyboardFocus="OnTransactionNameTextBoxFocusChanged"
                                IsEnabled="{Binding CanEditTransactionName, Mode=OneWay}"
                                LostKeyboardFocus="OnTransactionNameTextBoxLostKeyboardFocus"
                                Style="{StaticResource RoundedTextInputStyle}"
                                Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <customControls:BalloonCheckBox
                                Grid.Column="2"
                                ButtonIcon="{StaticResource CreditCardOff}"
                                ButtonSize="38"
                                CornerRadius="12"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                IconSize="14"
                                IsChecked="{Binding IsBudgetExcluded, Mode=TwoWay}"
                                IsEnabled="{Binding CanToggleBudgetExclusion, Mode=OneWay}"
                                ToolTip="Exclude from budget"
                                UncheckedText="Exclude" />
                            <customControls:BalloonCheckBox
                                Grid.Column="4"
                                ButtonIcon="{StaticResource Pin}"
                                ButtonSize="38"
                                CheckedBackground="{StaticResource Brush.BalloonButton.Background.ConfirmSave}"
                                CornerRadius="12"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                IconSize="14"
                                IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                IsEnabled="{Binding CanPinTransaction, Mode=OneWay}"
                                ToolTip="Pin transaction"
                                UncheckedText="Pinned" />
                        </Grid>
                        <Popup
                            x:Name="ExpenseNameSuggestionsPopup"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=ExpenseNameTextBox, Mode=OneWay}"
                            PopupAnimation="Fade"
                            StaysOpen="False"
                            VerticalOffset="6">
                            <ListBox
                                x:Name="ExpenseNameSuggestionsListBox"
                                ItemContainerStyle="{StaticResource TransactionNameSuggestionListBoxItemStyle}"
                                ItemTemplate="{StaticResource TransactionNameSuggestionTemplate}"
                                ItemsSource="{Binding TransactionNameSuggestions, Mode=OneWay}"
                                SelectionChanged="OnTransactionNameSuggestionSelectionChanged"
                                Style="{StaticResource TransactionNameSuggestionListBoxStyle}" />
                        </Popup>

                        <Grid Margin="0,16,0,0" Visibility="{Binding ShowTransactionModes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Style="{StaticResource FieldHeaderGridStyle}">
                                    <TextBlock
                                        Margin="0"
                                        Style="{StaticResource SectionLabelStyle}"
                                        Text="Amount" />
                                </Grid>
                                <customControls:MoneyTextBox
                                    x:Name="ExpenseAmountTextBox"
                                    LostKeyboardFocus="OnTransactionAmountTextBoxLostKeyboardFocus"
                                    Style="{StaticResource RoundedMoneyTextInputStyle}"
                                    Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyAmountToCanonicalConverter}}"
                                    TextChanged="OnTransactionAmountTextBoxTextChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" IsEnabled="{Binding ShowDateSelector, Mode=OneWay}">
                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Date" />
                                <components:DateSelector
                                    x:Name="ExpenseTransactionDateSelector"
                                    IsEnabled="{Binding CanEditDate, Mode=OneWay}"
                                    SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRepayment, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Style="{StaticResource FieldHeaderGridStyle}">
                                <TextBlock
                                    Margin="0"
                                    Style="{StaticResource SectionLabelStyle}"
                                    Text="Amount" />
                            </Grid>
                            <customControls:MoneyTextBox
                                x:Name="RepaymentAmountTextBox"
                                LostKeyboardFocus="OnTransactionAmountTextBoxLostKeyboardFocus"
                                Style="{StaticResource RoundedMoneyTextInputStyle}"
                                Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyAmountToCanonicalConverter}}"
                                TextChanged="OnTransactionAmountTextBoxTextChanged" />
                        </StackPanel>

                        <Grid Margin="0,16,0,0" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <customControls:BalloonRadioButton
                                Grid.Column="0"
                                CheckedBackground="{StaticResource Brush.Success}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                GroupName="AddTransactionMode"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                IconSize="14"
                                IsChecked="{Binding IsRegularMode, Mode=TwoWay}"
                                IsEnabled="{Binding CanToggleRecurring, Mode=OneWay}"
                                ShouldShowText="True"
                                UncheckedIcon="{StaticResource CreditCardAlt}"
                                UncheckedText="Regular" />
                            <customControls:BalloonRadioButton
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                CheckedBackground="{StaticResource Brush.Success}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                GroupName="AddTransactionMode"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                IconSize="14"
                                IsChecked="{Binding IsRecurring, Mode=TwoWay}"
                                IsEnabled="{Binding CanToggleRecurring, Mode=OneWay}"
                                ShouldShowText="True"
                                UncheckedIcon="{StaticResource RegularRepeat}"
                                UncheckedText="Recurring" />
                            <customControls:BalloonRadioButton
                                Grid.Column="4"
                                Margin="8,0,0,0"
                                CheckedBackground="{StaticResource Brush.Success}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                GroupName="AddTransactionMode"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                IconSize="14"
                                IsChecked="{Binding IsInstallments, Mode=TwoWay}"
                                IsEnabled="{Binding CanUseInstallments, Mode=OneWay}"
                                ShouldShowText="True"
                                UncheckedIcon="{StaticResource CreditCardClockOutline}"
                                UncheckedText="Installment" />
                            <customControls:BalloonRadioButton
                                Grid.Column="6"
                                Margin="8,0,0,0"
                                CheckedBackground="{StaticResource Brush.Success}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                GroupName="AddTransactionMode"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                IconSize="14"
                                IsChecked="{Binding IsUnpostedIoUMode, Mode=TwoWay}"
                                IsEnabled="{Binding CanUseIoU, Mode=OneWay}"
                                ShouldShowText="True"
                                UncheckedIcon="{StaticResource CreditCardMinusSolid}"
                                UncheckedText="Unposted IoU" />
                            <customControls:BalloonRadioButton
                                Grid.Column="8"
                                Margin="8,0,0,0"
                                CheckedBackground="{StaticResource Brush.Success}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                GroupName="AddTransactionMode"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                IconSize="14"
                                IsChecked="{Binding IsPostedIoUMode, Mode=TwoWay}"
                                IsEnabled="{Binding CanUseIoU, Mode=OneWay}"
                                ShouldShowText="True"
                                UncheckedIcon="{StaticResource CreditCardMinusSolid}"
                                UncheckedText="Posted IoU" />
                        </Grid>
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource Bold}"
                            FontSize="11"
                            Foreground="{StaticResource Brush.Text.Secondary}"
                            Text="{Binding TransactionModeDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="{DynamicResource Brush.Background.Surface}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="{Binding ShowRecurringDayInput, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Recurrence" />
                                    <ComboBox
                                        ItemsSource="{Binding RecurringPeriods, Mode=OneWay}"
                                        SelectedItem="{Binding SelectedRecurringPeriod, Mode=TwoWay}"
                                        Style="{StaticResource FluxoComboBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Schedule" />
                                    <ComboBox
                                        DisplayMemberPath="Label"
                                        ItemsSource="{Binding WeekdayOptions, Mode=OneWay}"
                                        SelectedValue="{Binding RecurringTimeText, Mode=TwoWay}"
                                        SelectedValuePath="Value"
                                        Style="{StaticResource FluxoComboBoxStyle}"
                                        Visibility="{Binding ShowRecurringWeekdayInput, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                    <customControls:NumericUpDown
                                        LowerLimit="1"
                                        Step="1"
                                        UpperLimit="28"
                                        Visibility="{Binding ShowRecurringMonthlyInput, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                        Value="{Binding RecurringTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,16,0,0"
                                    Visibility="{Binding ShowInstallmentEndDate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Start Date" />
                                    <components:DateSelector SelectedDate="{Binding StartDate, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0,16,0,0"
                                    Visibility="{Binding ShowInstallmentEndDate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="End Date" />
                                    <components:DateSelector SelectedDate="{Binding InstallmentEndDate, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Margin="0,16,0,0"
                                FontFamily="{DynamicResource Regular}"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.Mint.Muted}"
                                Text="{Binding InstallmentSummaryText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{Binding ShowInstallmentEndDate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}">
                        <Grid x:Name="CategoryAccountGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition>
                                    <ColumnDefinition.Style>
                                        <Style TargetType="ColumnDefinition">
                                            <Setter Property="Width" Value="*" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ShowCategoryOrRepaymentField, ElementName=CategoryAccountGrid, Mode=OneWay}" Value="False">
                                                    <Setter Property="Width" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ColumnDefinition.Style>
                                </ColumnDefinition>
                                <ColumnDefinition>
                                    <ColumnDefinition.Style>
                                        <Style TargetType="ColumnDefinition">
                                            <Setter Property="Width" Value="16" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ShowCategoryOrRepaymentField, ElementName=CategoryAccountGrid, Mode=OneWay}" Value="False">
                                                    <Setter Property="Width" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ColumnDefinition.Style>
                                </ColumnDefinition>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource SectionLabelStyle}"
                                Text="{Binding CategoryFieldLabel, Mode=OneWay}"
                                Visibility="{Binding ShowCategoryOrRepaymentField, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource SectionLabelStyle}"
                                Text="Account" />

                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Visibility="{Binding ShowCategoryOrRepaymentField, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Margin="-2,8,0,0" Visibility="{Binding ShowCategoryField, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <customControls:BalloonRadioButton
                                            ButtonIcon="{StaticResource Home}"
                                            CheckedBackground="{StaticResource Brush.Mint}"
                                            CornerRadius="8"
                                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                            GroupName="ExpenseCategory"
                                            HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                            IconSize="12"
                                            IsChecked="{Binding IsNeedsCategory, Mode=TwoWay}"
                                            IsEnabled="{Binding CanEditCategory, Mode=OneWay}"
                                            ShouldShowText="True"
                                            UncheckedText="Needs" />
                                        <customControls:BalloonRadioButton
                                            Margin="8,0,0,0"
                                            ButtonIcon="{StaticResource ShoppingBag}"
                                            CheckedBackground="{StaticResource Brush.Mint}"
                                            CornerRadius="8"
                                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                            GroupName="ExpenseCategory"
                                            HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                            IconSize="12"
                                            IsChecked="{Binding IsWantsCategory, Mode=TwoWay}"
                                            IsEnabled="{Binding CanEditCategory, Mode=OneWay}"
                                            ShouldShowText="True"
                                            UncheckedText="Wants" />
                                        <customControls:BalloonRadioButton
                                            Margin="8,0,0,0"
                                            ButtonIcon="{StaticResource TrendingUp}"
                                            CheckedBackground="{StaticResource Brush.Mint}"
                                            CornerRadius="8"
                                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                            GroupName="ExpenseCategory"
                                            HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                            IconSize="12"
                                            IsChecked="{Binding IsInvestCategory, Mode=TwoWay}"
                                            IsEnabled="{Binding CanEditCategory, Mode=OneWay}"
                                            ShouldShowText="True"
                                            UncheckedText="Invest" />
                                    </StackPanel>
                                </StackPanel>

                                <ComboBox
                                    DisplayMemberPath="Name"
                                    IsEnabled="{Binding CanChangeRepaymentAccount, Mode=OneWay}"
                                    ItemsSource="{Binding RepaymentAccounts, Mode=OneWay}"
                                    SelectedItem="{Binding SelectedRepaymentAccount, Mode=TwoWay}"
                                    Style="{StaticResource FluxoComboBoxStyle}"
                                    Visibility="{Binding ShowRepaymentAccountField, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            </Grid>

                            <ComboBox
                                x:Name="ExpenseAccountComboBox"
                                Grid.Row="1"
                                Grid.Column="2"
                                DisplayMemberPath="Name"
                                IsEnabled="{Binding CanEditAccount, Mode=OneWay}"
                                ItemsSource="{Binding AccountsView, Mode=OneWay}"
                                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                Style="{StaticResource FluxoComboBoxStyle}">
                                <ComboBox.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource AccountComboGroupHeaderTemplate}" />
                                </ComboBox.GroupStyle>
                            </ComboBox>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,12,24,0"
                                Orientation="Horizontal"
                                Visibility="{Binding ShowCategoryImpact, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    FontFamily="{StaticResource Medium}"
                                    Foreground="{StaticResource Brush.Text.Primary}"
                                    Text="{Binding CategoryCurrent, StringFormat=N0, Mode=OneWay}" />
                                <components:Icon
                                    Width="6"
                                    Margin="16,0"
                                    Path="{StaticResource AngleRight}"
                                    Color="{StaticResource Brush.Text.Primary}" />
                                <TextBlock FontFamily="{StaticResource Medium}" Text="{Binding CategoryToBe, StringFormat=N0, Mode=OneWay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIncome, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,12,24,0"
                                Orientation="Horizontal"
                                Visibility="{Binding ShowAccountImpact, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    FontFamily="{StaticResource Medium}"
                                    Foreground="{StaticResource Brush.Text.Primary}"
                                    Text="{Binding AccountCurrent, StringFormat=N0, Mode=OneWay}" />
                                <components:Icon
                                    Width="6"
                                    Margin="16,0"
                                    Path="{StaticResource AngleRight}"
                                    Color="{StaticResource Brush.Text.Primary}" />
                                <TextBlock FontFamily="{StaticResource Medium}" Text="{Binding AccountToBe, StringFormat=N0, Mode=OneWay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIncome, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid Style="{StaticResource FieldHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0"
                                    Style="{StaticResource SectionLabelStyle}"
                                    Text="Name" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="IncomeNameTextBox"
                                    GotKeyboardFocus="OnTransactionNameTextBoxFocusChanged"
                                    LostKeyboardFocus="OnTransactionNameTextBoxLostKeyboardFocus"
                                    Style="{StaticResource RoundedTextInputStyle}"
                                    Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <customControls:BalloonToggle
                                    Grid.Column="2"
                                    ButtonSize="38"
                                    CornerRadius="12"
                                    DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                    HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                    IconSize="14"
                                    IsEnabled="{Binding CanToggleRecurring, Mode=OneWay}"
                                    ToolTip="Transaction mode">
                                    <customControls:BalloonToggle.States>
                                        <customControls:BalloonToggleState
                                            ButtonIcon="{StaticResource RegularRepeat}"
                                            ButtonText="Recurring"
                                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Default}"
                                            HoverBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                            OnChecked="{Binding HandleRecurringModeClickCommand, Mode=OneWay}" />
                                        <customControls:BalloonToggleState
                                            ButtonIcon="{StaticResource CreditCardClockOutline}"
                                            ButtonText="Installments"
                                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Default}"
                                            HoverBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                            OnChecked="{Binding HandleInstallmentsModeClickCommand, Mode=OneWay}" />
                                        <customControls:BalloonToggleState
                                            ButtonIcon="{StaticResource CreditCardMinusSolid}"
                                            ButtonText="{Binding IoUTooltip, Mode=OneWay}"
                                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Caution}"
                                            HoverBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                            OnChecked="{Binding HandleIoUModeClickCommand, Mode=OneWay}" />
                                        <customControls:BalloonToggleState
                                            ButtonIcon="{StaticResource CreditCardOff}"
                                            ButtonText="Exclude"
                                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Caution}"
                                            HoverBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                            OnChecked="{Binding HandleExcludeModeClickCommand, Mode=OneWay}" />
                                        <customControls:BalloonToggleState
                                            ButtonIcon="{StaticResource CreditCardXRegular}"
                                            ButtonText="Set as Debt and Exclude"
                                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Caution}"
                                            HoverBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                            OnChecked="{Binding HandleExcludedIoUModeClickCommand, Mode=OneWay}" />
                                    </customControls:BalloonToggle.States>
                                </customControls:BalloonToggle>
                                <customControls:BalloonCheckBox
                                    Grid.Column="4"
                                    ButtonSize="38"
                                    CheckedBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                    DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                    HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                    IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                    IsEnabled="{Binding CanPinTransaction, Mode=OneWay}"
                                    ToolTip="Pinned"
                                    UncheckedIcon="{StaticResource Pin}"
                                    UncheckedText="Pinned" />
                            </Grid>
                            <Popup
                                x:Name="IncomeNameSuggestionsPopup"
                                AllowsTransparency="True"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=IncomeNameTextBox, Mode=OneWay}"
                                PopupAnimation="Fade"
                                StaysOpen="False"
                                VerticalOffset="6">
                                <ListBox
                                    x:Name="IncomeNameSuggestionsListBox"
                                    ItemContainerStyle="{StaticResource TransactionNameSuggestionListBoxItemStyle}"
                                    ItemTemplate="{StaticResource TransactionNameSuggestionTemplate}"
                                    ItemsSource="{Binding TransactionNameSuggestions, Mode=OneWay}"
                                    SelectionChanged="OnTransactionNameSuggestionSelectionChanged"
                                    Style="{StaticResource TransactionNameSuggestionListBoxStyle}" />
                            </Popup>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid Style="{StaticResource FieldHeaderGridStyle}">
                                <TextBlock
                                    Margin="0"
                                    Style="{StaticResource SectionLabelStyle}"
                                    Text="Amount" />
                            </Grid>
                            <customControls:MoneyTextBox
                                x:Name="IncomeAmountTextBox"
                                LostKeyboardFocus="OnTransactionAmountTextBoxLostKeyboardFocus"
                                Style="{StaticResource RoundedMoneyTextInputStyle}"
                                Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyAmountToCanonicalConverter}}"
                                TextChanged="OnTransactionAmountTextBoxTextChanged" />
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowInstallmentEndDate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="End Date" />
                                <components:DateSelector SelectedDate="{Binding InstallmentEndDate, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="{DynamicResource Regular}"
                                    FontSize="11"
                                    Foreground="{DynamicResource Brush.Text.Muted}"
                                    Text="{Binding InstallmentSummaryText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Account" />
                            <ComboBox
                                x:Name="IncomeAccountComboBox"
                                DisplayMemberPath="Name"
                                IsEnabled="{Binding CanEditAccount, Mode=OneWay}"
                                ItemsSource="{Binding AccountsView, Mode=OneWay}"
                                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                Style="{StaticResource FluxoComboBoxStyle}">
                                <ComboBox.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource AccountComboGroupHeaderTemplate}" />
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding DateOrRecurrenceLabel, Mode=OneWay}" />
                            <components:DateSelector
                                x:Name="IncomeTransactionDateSelector"
                                IsEnabled="{Binding CanEditDate, Mode=OneWay}"
                                SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                Visibility="{Binding ShowDateSelector, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            <StackPanel Visibility="{Binding ShowRecurringDayInput, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <ComboBox
                                    ItemsSource="{Binding RecurringPeriods, Mode=OneWay}"
                                    SelectedItem="{Binding SelectedRecurringPeriod, Mode=TwoWay}"
                                    Style="{StaticResource FluxoComboBoxStyle}" />
                                <ComboBox
                                    Margin="0,8,0,0"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{Binding WeekdayOptions, Mode=OneWay}"
                                    SelectedValue="{Binding RecurringTimeText, Mode=TwoWay}"
                                    SelectedValuePath="Value"
                                    Style="{StaticResource FluxoComboBoxStyle}"
                                    Visibility="{Binding ShowRecurringWeekdayInput, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                <customControls:NumericUpDown
                                    Margin="0,8,0,0"
                                    LowerLimit="1"
                                    Step="1"
                                    UpperLimit="28"
                                    Visibility="{Binding ShowRecurringMonthlyInput, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    Value="{Binding RecurringTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="Collapsed">
                    <StackPanel>
                        <Grid Style="{StaticResource FieldHeaderGridStyle}">
                            <TextBlock
                                Margin="0"
                                Style="{StaticResource SectionLabelStyle}"
                                Text="Amount" />
                        </Grid>
                        <customControls:MoneyTextBox
                            x:Name="GoalAmountTextBox"
                            LostKeyboardFocus="OnTransactionAmountTextBoxLostKeyboardFocus"
                            Style="{StaticResource RoundedMoneyTextInputStyle}"
                            Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyAmountToCanonicalConverter}}"
                            TextChanged="OnTransactionAmountTextBoxTextChanged" />
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding DateOrRecurrenceLabel, Mode=OneWay}" />
                            <components:DateSelector
                                x:Name="GoalTransactionDateSelector"
                                SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                Visibility="{Binding ShowDateSelector, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            <StackPanel Visibility="{Binding ShowRecurringDayInput, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <ComboBox
                                    ItemsSource="{Binding RecurringPeriods, Mode=OneWay}"
                                    SelectedItem="{Binding SelectedRecurringPeriod, Mode=TwoWay}"
                                    Style="{StaticResource FluxoComboBoxStyle}" />
                                <ComboBox
                                    Margin="0,8,0,0"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{Binding WeekdayOptions, Mode=OneWay}"
                                    SelectedValue="{Binding RecurringTimeText, Mode=TwoWay}"
                                    SelectedValuePath="Value"
                                    Style="{StaticResource FluxoComboBoxStyle}"
                                    Visibility="{Binding ShowRecurringWeekdayInput, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                <customControls:NumericUpDown
                                    Margin="0,8,0,0"
                                    LowerLimit="1"
                                    Step="1"
                                    UpperLimit="28"
                                    Visibility="{Binding ShowRecurringMonthlyInput, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    Value="{Binding RecurringTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Account" />
                            <ComboBox
                                x:Name="GoalAccountComboBox"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding AccountsView, Mode=OneWay}"
                                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                Style="{StaticResource FluxoComboBoxStyle}">
                                <ComboBox.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource AccountComboGroupHeaderTemplate}" />
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Goal" />
                        <ComboBox
                            x:Name="GoalComboBox"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Goals, Mode=OneWay}"
                            SelectedItem="{Binding SelectedGoal, Mode=TwoWay}"
                            Style="{StaticResource FluxoComboBoxStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel
                x:Name="TagsPanel"
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,16,0,0"
                IsEnabled="{Binding CanEditTags, Mode=OneWay}"
                Visibility="{Binding CanEditTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Tags" />
                <DockPanel x:Name="TagsDockPanel" LastChildFill="False">
                    <Button
                        x:Name="AddTagButton"
                        Margin="0,0,8,0"
                        Click="OnAddTagClick"
                        Content="+ Add Tag"
                        DockPanel.Dock="Left"
                        Style="{StaticResource PopupTagButtonStyle}" />

                    <ListBox
                        x:Name="VisibleTagsListBox"
                        DockPanel.Dock="Left"
                        ItemContainerStyle="{StaticResource PopupTagListBoxItemStyle}"
                        ItemTemplate="{StaticResource PopupTagTemplate}"
                        ItemsPanel="{StaticResource PopupVisibleTagsItemsPanelTemplate}"
                        ItemsSource="{Binding VisibleTags, Mode=OneWay}"
                        SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                        SelectionChanged="OnTagSelectionChanged"
                        Style="{StaticResource PopupTagListBoxStyle}" />

                    <ToggleButton
                        x:Name="MoreTagsButton"
                        Margin="4,0,0,0"
                        Checked="OnMoreTagsButtonChecked"
                        Content="More"
                        IsChecked="{Binding IsMoreTagsOpen, Mode=TwoWay}"
                        MouseEnter="OnMoreTagsHoverChanged"
                        MouseLeave="OnMoreTagsHoverChanged"
                        Style="{StaticResource PopupTagToggleStyle}"
                        Unchecked="OnMoreTagsButtonUnchecked"
                        Visibility="{Binding HasMoreTags, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </DockPanel>

                <Popup
                    x:Name="MoreTagsPopup"
                    AllowsTransparency="True"
                    Closed="OnMoreTagsPopupClosed"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=MoreTagsButton, Mode=OneWay}"
                    PopupAnimation="Fade"
                    StaysOpen="True"
                    VerticalOffset="8">
                    <Border
                        x:Name="MoreTagsPopupContent"
                        MaxWidth="360"
                        Padding="12"
                        Background="{DynamicResource Brush.Background.Elevated}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="16"
                        MouseEnter="OnMoreTagsHoverChanged"
                        MouseLeave="OnMoreTagsHoverChanged">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontFamily="{DynamicResource Bold}"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                Text="More Tags" />
                            <ListBox
                                x:Name="MoreTagsListBox"
                                ItemContainerStyle="{StaticResource PopupOtherTagListBoxItemStyle}"
                                ItemTemplate="{StaticResource PopupTagTemplate}"
                                ItemsPanel="{StaticResource PopupOverflowTagsItemsPanelTemplate}"
                                ItemsSource="{Binding OverflowTags, Mode=OneWay}"
                                SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                                SelectionChanged="OnTagSelectionChanged"
                                Style="{StaticResource PopupTagListBoxStyle}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <StackPanel
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,16,0,0">
                <StackPanel Visibility="{Binding ShowNoteField, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Note" />
                    <Border Style="{StaticResource PopupFieldBorderStyle}">
                        <TextBox
                            x:Name="NoteRichTextBox"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="{DynamicResource Brush.Text.Primary}"
                            FontFamily="{DynamicResource Regular}"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            TextChanged="OnNoteTextChanged"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <Border
                        Margin="0,8,0,0"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        Background="{StaticResource Brush.Background.Elevated}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="0,0,8,8"
                        ToolTipService.ShowDuration="60000"
                        Visibility="{Binding HasTransactionWarnings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.ToolTip>
                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}, Mode=OneWay}">
                                <Border
                                    Padding="10"
                                    Background="{StaticResource Brush.Background.Elevated}"
                                    CornerRadius="8">
                                    <ItemsControl ItemTemplate="{StaticResource TransactionWarningTemplate}" ItemsSource="{Binding TransactionWarnings, Mode=OneWay}" />
                                </Border>
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <components:Icon
                                Width="12"
                                Height="12"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Path="{StaticResource ExclamationTriangle}"
                                Color="{StaticResource Brush.Danger}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Medium}"
                                FontSize="11"
                                Foreground="{StaticResource Brush.Danger}"
                                Text="{Binding TransactionFeedbackCount, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowGoalField, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Goal" />
                    <ComboBox
                        x:Name="SharedGoalComboBox"
                        VerticalAlignment="Top"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Goals, Mode=OneWay}"
                        SelectedItem="{Binding SelectedGoal, Mode=TwoWay}"
                        Style="{StaticResource FluxoComboBoxStyle}" />
                </StackPanel>
            </StackPanel>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="4"
                Grid.Column="2"
                Width="400"
                Height="520"
                Visibility="{Binding ShowSidePanel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <customControls:SegmentedToggleGroup
                    Margin="0,0,0,12"
                    SelectedValue="{Binding SelectedSidePanel, Mode=TwoWay}"
                    Visibility="{Binding ShowSidePanelToggle, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <customControls:SegmentedToggleOption Content="History" Value="{x:Static dataEnums:TransactionPopupSidePanel.History}" />
                    <customControls:SegmentedToggleOption Content="Pinned" Value="{x:Static dataEnums:TransactionPopupSidePanel.Pinned}" />
                    <customControls:SegmentedToggleOption Content="Split" Value="{x:Static dataEnums:TransactionPopupSidePanel.Split}" />
                </customControls:SegmentedToggleGroup>

                <customControls:FadingScrollViewer
                    Grid.Row="1"
                    Margin="0"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding ShowHistoryPanel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox
                        ItemContainerStyle="{StaticResource TransactionHistoryListBoxItemStyle}"
                        ItemTemplate="{StaticResource TransactionHistoryItemTemplate}"
                        ItemsSource="{Binding TransactionHistory.Items, Mode=OneWay}"
                        PreviewMouseWheel="OnHistoryListPreviewMouseWheel"
                        SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                        Style="{StaticResource TransactionHistoryListBoxStyle}" />
                </customControls:FadingScrollViewer>

                <customControls:FadingScrollViewer
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding ShowPinnedPanel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox
                        ItemContainerStyle="{StaticResource TransactionHistoryListBoxItemStyle}"
                        ItemTemplate="{StaticResource TransactionHistoryItemTemplate}"
                        ItemsSource="{Binding PinnedHistory.Items, Mode=OneWay}"
                        PreviewMouseWheel="OnHistoryListPreviewMouseWheel"
                        SelectedItem="{Binding SelectedPinnedHistoryItem, Mode=TwoWay}"
                        Style="{StaticResource TransactionHistoryListBoxStyle}" />
                </customControls:FadingScrollViewer>

                <Grid Grid.Row="1" Visibility="{Binding ShowSplitPanel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Medium}"
                        Foreground="{StaticResource Brush.Text.Muted}"
                        Text="Transaction is invalid."
                        Visibility="{Binding ShowInvalidSplitPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <customControls:FadingScrollViewer
                        PreviewMouseWheel="OnSplitPanelPreviewMouseWheel"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ShowInvalidSplitPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}">
                        <StackPanel>
                            <Button
                                Click="OnRootSplitCardClick"
                                Command="{Binding SelectSplitCommand}"
                                CommandParameter="{x:Null}"
                                Style="{StaticResource SplitTransactionRootCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontFamily="{StaticResource Bold}"
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            Text="{Binding PendingTransaction.Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            FontFamily="{StaticResource Bold}"
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            Text="{Binding PendingTransaction.Amount, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                                    </Grid>
                                    <ProgressBar
                                        Grid.Row="1"
                                        Height="12"
                                        Margin="0,12,0,0"
                                        Maximum="{Binding PendingTransaction.Amount, Mode=OneWay}"
                                        Style="{StaticResource RoundedProgressBarStyle}"
                                        Visibility="{Binding CanModifySplitTree, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Value="{Binding PendingTransaction.ChildAmountTotal, Mode=OneWay}" />
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource Medium}"
                                            Foreground="{StaticResource Brush.Text.Primary}">
                                            <Run Text="{Binding SplitAmountRemaining, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                                            <Run Text=" left" />
                                        </TextBlock>
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Visibility="{Binding CanModifySplitTree, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <customControls:BalloonButton
                                                Margin="0,0,8,0"
                                                ButtonIcon="{StaticResource CallSplit}"
                                                ButtonText="Split Equally"
                                                Command="{Binding SplitEquallyCommand}"
                                                CommandParameter="{x:Null}"
                                                CornerRadius="8"
                                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                                ShouldShowText="True" />
                                            <customControls:BalloonButton
                                                ButtonIcon="{StaticResource RegularUndo}"
                                                ButtonText="Reset"
                                                Command="{Binding ResetSplitCommand}"
                                                CommandParameter="{x:Null}"
                                                CornerRadius="8"
                                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                                ShouldShowText="True" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                            <TreeView
                                x:Name="SplitTransactionTree"
                                Margin="0,8,0,0"
                                ItemTemplate="{StaticResource SplitTransactionBranchTemplate}"
                                ItemsSource="{Binding PendingTransaction.ChildTransactions, Mode=OneWay}"
                                Style="{StaticResource SplitTransactionTreeViewStyle}" />
                            <Button
                                Width="Auto"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding AddSplitCommand, Mode=OneWay}"
                                CommandParameter="{x:Null}"
                                Content="Add a sub-transaction"
                                Style="{StaticResource DashedButtonStyle}"
                                Visibility="{Binding ShowRootSplitAddAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <customControls:BalloonButton
                                Margin="2,8,0,0"
                                HorizontalAlignment="Left"
                                ButtonIcon="{StaticResource PlusSolid}"
                                ButtonText="+"
                                Command="{Binding AddSplitCommand, Mode=OneWay}"
                                CommandParameter="{x:Null}"
                                ToolTip="Add a sub-transaction"
                                Visibility="{Binding ShowRootSplitPlusAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </customControls:FadingScrollViewer>
                </Grid>
            </Grid>

            <Border
                Grid.RowSpan="10"
                Grid.ColumnSpan="2"
                Panel.ZIndex="10"
                Background="Transparent"
                Visibility="{Binding IsViewOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Border>
</customControls:BasePopup>
