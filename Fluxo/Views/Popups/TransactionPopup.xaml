<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.TransactionPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Fluxo.Resources.Behaviors;assembly=Fluxo.Resources"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataEnums="clr-namespace:Fluxo.Data.Enums;assembly=Fluxo.Data"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:popups="clr-namespace:Fluxo.ViewModels.Popups"
    CanClone="{Binding CanCloneViewedTransaction, Mode=OneWay}"
    CanDelete="{Binding CanDeleteViewedTransaction, Mode=OneWay}"
    CanEdit="{Binding CanEditViewedTransaction, Mode=OneWay}"
    CanToggleBulk="{Binding CanToggleBulk, Mode=OneWay}"
    IsSaveButtonEnabled="{Binding CanPersist, Mode=OneWay}"
    Mode="{Binding PopupMode, Mode=OneWay}"
    PopupTitle="{Binding PopupTitle, Mode=OneWay}"
    mc:Ignorable="d">

    <customControls:BasePopup.Resources>

<ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fluxo;component/Resources/Styles/TransactionSplitTreeStyles.xaml" />
                <ResourceDictionary Source="/Fluxo;component/Resources/Styles/TransactionBalanceUpdateStyles.xaml" />
</ResourceDictionary.MergedDictionaries>

<Style x:Key="TransactionFeedbackIconStyle" BasedOn="{StaticResource BaseIconStyle}" TargetType="components:Icon">
    <Setter Property="Color" Value="{DynamicResource Brush.Danger}" />
    <Style.Triggers>
        <DataTrigger Binding="{Binding HasErrors, Mode=OneWay}" Value="False">
            <Setter Property="Color" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
    </Style.Triggers>
</Style>

<Style
        x:Key="PopupTagItemRadioStyle"
        BasedOn="{StaticResource BaseRadioButtonStyle}"
        TargetType="RadioButton">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                x:Name="ColorDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{Binding HexCode}" />
                            <TextBlock
                                x:Name="TagText"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                Text="{TemplateBinding Content}" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ColorDot" Property="Fill" Value="{Binding HexCode, Converter={StaticResource BackgroundToForegroundConverter}}" />
                            <Setter TargetName="TagText" Property="Foreground" Value="{Binding HexCode, Converter={StaticResource BackgroundToForegroundConverter}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{Binding HexCode}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Background.Surface}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>
<Style x:Key="PopupTagButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="Fill"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            Opacity="0" />
                        <Rectangle
                            RadiusX="14"
                            RadiusY="14"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeDashArray="5,3"
                            StrokeThickness="1" />
                        <TextBlock
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Content}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Mint}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

            <Style x:Key="SectionLabelStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            </Style>

            <Style x:Key="TransactionWarningTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Medium}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWarning, Mode=OneWay}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PopupFieldBorderStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="PopupTagListBoxStyle" BasedOn="{StaticResource BaseListBoxStyle}" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style x:Key="PopupTagListBoxItemStyle" BasedOn="{StaticResource BaseListBoxItemStyle}" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="PopupTagTemplate">
                <RadioButton
                    Content="{Binding Name, Mode=OneWay}"
                    GroupName="AddNewTransactionTags"
                    IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}"
                    Style="{StaticResource PopupTagItemRadioStyle}" />
            </DataTemplate>

            <Style x:Key="TransactionNameSuggestionListBoxStyle" BasedOn="{StaticResource BaseListBoxStyle}" TargetType="ListBox">
                <Setter Property="MinWidth" Value="260" />
                <Setter Property="MaxHeight" Value="220" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>

            <Style x:Key="TransactionNameSuggestionListBoxItemStyle" BasedOn="{StaticResource BaseListBoxItemStyle}" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="ItemBackground"
                                Padding="8,6"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TransactionHistoryListBoxStyle" BasedOn="{StaticResource BaseListBoxStyle}" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style x:Key="TransactionHistoryListBoxItemStyle" BasedOn="{StaticResource BaseListBoxItemStyle}" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="ItemBackground"
                                Padding="10,8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource Brush.Border.Accent.Muted}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsValid, Mode=OneWay}" Value="False">
                                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TransactionQueueListBoxItemStyle" BasedOn="{StaticResource BaseListBoxItemStyle}" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="ItemBackground"
                                Padding="10,8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
                                    <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="TransactionHistoryItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="8"
                        Height="8"
                        Margin="0,5,10,0"
                        VerticalAlignment="Top"
                        Fill="{Binding TagHexCode, FallbackValue={DynamicResource Brush.Mint}, TargetNullValue={DynamicResource Brush.Mint}, Mode=OneWay}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontFamily="{DynamicResource Bold}"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontFamily="{DynamicResource Regular}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding AccountName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="{DynamicResource Bold}"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Amount, StringFormat={}{0:N2}, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,3,0,0"
                            HorizontalAlignment="Right"
                            FontFamily="{DynamicResource Regular}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding Date, Converter={StaticResource DateTimeToRelativeDateConverter}, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TransactionQueueItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="8"
                        Height="8"
                        Margin="0,5,10,0"
                        VerticalAlignment="Top"
                        Fill="{Binding Tag.HexCode, FallbackValue={DynamicResource Brush.Mint}, TargetNullValue={DynamicResource Brush.Mint}, Mode=OneWay}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontFamily="{DynamicResource Bold}"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontFamily="{DynamicResource Regular}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding Account.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Margin="12,0,0,0">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="{DynamicResource Bold}"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Amount, StringFormat={}{0:N0}, Mode=OneWay}" />
                        <components:Icon Style="{StaticResource TransactionCardStatusIconStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ChildTransactionItemTemplate">
                <Border
                    Margin="0,0,0,10"
                    Padding="16"
                    Background="{DynamicResource Brush.Background.Elevated}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontFamily="{DynamicResource Bold}"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                Text="{Binding Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                FontFamily="{DynamicResource Bold}"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.Danger}"
                                Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:#,##0}}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            FontFamily="{DynamicResource Medium}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding OccurredOn, Mode=OneWay, StringFormat={}{0:MMM d, yyyy}}" />

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                            <Border
                                MaxWidth="96"
                                Padding="8,2"
                                Background="{Binding TagHexCode, Mode=OneWay}"
                                CornerRadius="8">
                                <TextBlock
                                    FontFamily="{DynamicResource Bold}"
                                    FontSize="10"
                                    Text="{Binding TagName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Foreground>
                                        <Binding
                                            Converter="{StaticResource BackgroundToForegroundConverter}"
                                            Path="Background"
                                            RelativeSource="{RelativeSource AncestorType=Border}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                            <TextBlock
                                Margin="8,2,0,0"
                                FontFamily="{DynamicResource Medium}"
                                FontSize="10"
                                Foreground="{DynamicResource Brush.Text.Muted}"
                                Text="{Binding CategoryLabel, Mode=OneWay}" />
                        </StackPanel>
                        <Path
                            Grid.Row="2"
                            Width="13"
                            Height="13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Data="{StaticResource CreditCardMinusSolid}"
                            Fill="{DynamicResource Brush.Info}"
                            Stretch="Uniform"
                            ToolTip="Lend"
                            Visibility="{Binding IsIoU, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <Style
                x:Key="ExpenseCategoryComboBoxItemStyle"
                BasedOn="{StaticResource FluxoComboBoxItemStyle}"
                TargetType="ComboBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsEnabled, Mode=OneWay}" />
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsEnabled, Mode=OneWay}" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="TransactionNameSuggestionTemplate">
                <Grid Width="320" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontFamily="{DynamicResource Bold}"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontFamily="{DynamicResource Regular}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding AccountName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Bold}"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding Amount, StringFormat={}{0:N2}, Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TransactionWarningTemplate">
                <TextBlock Style="{StaticResource TransactionWarningTextStyle}" Text="{Binding Message, Mode=OneWay}" />
            </DataTemplate>

            <DataTemplate x:Key="TransactionFieldFeedbackTemplate">
                <Grid Width="10" Height="10">
                    <components:Icon
                        x:Name="FeedbackIcon"
                        Width="10"
                        Height="10"
                        Path="{StaticResource ExclamationTriangle}"
                        Visibility="{Binding HasFeedback, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource TransactionFeedbackIconStyle}">

                    </components:Icon>
                    <Popup
                        AllowsTransparency="True"
                        IsOpen="{Binding IsMouseOver, ElementName=FeedbackIcon, Mode=OneWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=FeedbackIcon, Mode=OneWay}"
                        PopupAnimation="Fade"
                        StaysOpen="False">
                        <Border
                            Margin="0,6,0,0"
                            Padding="10"
                            Background="{DynamicResource Brush.Background.Elevated}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ItemsControl ItemTemplate="{StaticResource TransactionWarningTemplate}" ItemsSource="{Binding Warnings, Mode=OneWay}" />
                        </Border>
                    </Popup>
                </Grid>
            </DataTemplate>

<Style BasedOn="{StaticResource BaseGridStyle}" TargetType="Grid" x:Key="TransactionPopupRootGridStyle">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsViewOnly, Mode=OneWay}" Value="True">
                            <Setter Property="Focusable" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

<Style BasedOn="{StaticResource BaseColumnDefinitionStyle}" TargetType="ColumnDefinition" x:Key="BulkQueueColumnStyle">
                            <Setter Property="Width" Value="220" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBulkMode, Mode=OneWay}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

<Style BasedOn="{StaticResource BaseColumnDefinitionStyle}" TargetType="ColumnDefinition" x:Key="BulkQueueGutterColumnStyle">
                            <Setter Property="Width" Value="20" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBulkMode, Mode=OneWay}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

<Style BasedOn="{StaticResource BaseColumnDefinitionStyle}" TargetType="ColumnDefinition" x:Key="RightFormDividerColumnStyle">
                            <Setter Property="Width" Value="20" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRightFormDivider, Mode=OneWay}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

<DataTemplate x:Key="TransactionQueueGroupHeaderTemplate">
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontFamily="{DynamicResource Bold}"
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.Text.Muted}"
                                        Text="{Binding Name, StringFormat={}{0:ddd, MMM d, yyyy}}" />
                                </DataTemplate>

<Style BasedOn="{StaticResource BaseColumnDefinitionStyle}" TargetType="ColumnDefinition" x:Key="CategoryFieldColumnStyle">
                                                        <Setter Property="Width" Value="Auto" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.ShowCategoryOrRepaymentField, ElementName=CategoryAccountGrid, Mode=OneWay}" Value="False">
                                                                <Setter Property="Width" Value="0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.IsRepayment, ElementName=CategoryAccountGrid, Mode=OneWay}" Value="True">
                                                                <Setter Property="Width" Value="*" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>

<Style BasedOn="{StaticResource BaseColumnDefinitionStyle}" TargetType="ColumnDefinition" x:Key="CategoryFieldGutterColumnStyle">
                                                        <Setter Property="Width" Value="16" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.ShowCategoryOrRepaymentField, ElementName=CategoryAccountGrid, Mode=OneWay}" Value="False">
                                                                <Setter Property="Width" Value="0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>

<Style BasedOn="{StaticResource RoundedProgressBarStyle}" TargetType="ProgressBar" x:Key="SplitProgressBarStyle">
