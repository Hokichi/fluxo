<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.QuickAddPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FocusManager.FocusedElement="{Binding ElementName=EditQuickAccessButton, Mode=OneWay}"
    PopupTitle="Quick Access"
    SizeToContent="WidthAndHeight"
    mc:Ignorable="d">

    <customControls:BasePopup.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/QuickAccessPopupResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </customControls:BasePopup.Resources>

    <Grid
        Width="760"
        Margin="40,6,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <customControls:BalloonButton
            x:Name="EditQuickAccessButton"
            HorizontalAlignment="Right"
            AutomationProperties.Name="{Binding EditButtonText, Mode=OneWay}"
            ButtonIcon="{StaticResource Pen}"
            ButtonText="{Binding EditButtonText, Mode=OneWay}"
            Click="OnEditDoneClick"
            Style="{StaticResource QuickAccessEditBalloonButtonStyle}" />

        <ItemsControl
            x:Name="QuickAccessRows"
            Grid.Row="2"
            ItemsSource="{Binding TileRows, Mode=OneWay}"
            Style="{StaticResource QuickAccessRowsItemsControlStyle}" />

        <TextBlock
            x:Name="QuickAccessEmptyState"
            Grid.Row="2"
            Style="{StaticResource QuickAccessEmptyStateTextStyle}"
            Text="No tiles are visible. Choose Edit to add Quick Access actions."
            Visibility="{Binding IsEmptyStateVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</customControls:BasePopup>
