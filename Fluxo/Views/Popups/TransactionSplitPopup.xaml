                            SnapsToDevicePixels="True" />

                        <customControls:FadingScrollViewer
                            Width="720"
                            MaxHeight="330"
                            Margin="0"
                            HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl
                                    x:Name="SplitRowsItemsControl"
                                    ItemsSource="{Binding SplitRows, Mode=OneWay}"
                                    Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="720"
                                                Margin="0,12,0,0"
                                                Padding="12"
                                                Style="{StaticResource CardBorderStyle}">
                                                <StackPanel>
                                                    <Grid Margin="0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="240" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SplitCategory" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource RoundedTextInputStyle}"
                                                            Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                        <Grid
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Margin="0,12,8,0">
                                                            <customControls:MoneyTextBox Style="{StaticResource RoundedMoneyTextInputStyle}" Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyAmountToCanonicalConverter}}" />
                                                            <Border
                                                                BorderBrush="{DynamicResource Brush.Danger}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding IsCausingNegativeRemainder, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                        </Grid>

                                                        <StackPanel
                                                            Grid.Row="1"
                                                            Grid.Column="2"
                                                            Margin="0,12,8,0"
                                                            IsEnabled="{Binding CanSelectCategory, Mode=OneWay}"
                                                            Orientation="Horizontal">
                                                            <customControls:BalloonRadioButton
                                                                GroupName="SplitCategory"
                                                                IsChecked="{Binding IsNeedsCategory, Mode=TwoWay}"
                                                                ShouldShowText="True"
                                                                UncheckedText="Needs" />
                                                            <customControls:BalloonRadioButton
                                                                GroupName="SplitCategory"
                                                                IsChecked="{Binding IsWantsCategory, Mode=TwoWay}"
                                                                ShouldShowText="True"
                                                                UncheckedText="Wants" />
                                                            <customControls:BalloonRadioButton
                                                                GroupName="SplitCategory"
                                                                IsChecked="{Binding IsInvestCategory, Mode=TwoWay}"
                                                                ShouldShowText="True"
                                                                UncheckedText="Invest" />
                                                        </StackPanel>

                                                        <Grid
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="4"
                                                            Margin="0,12,8,0"
                                                            Visibility="{Binding ShowLeafTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ToggleButton
                                                                x:Name="SplitRowTagToggleButton"
                                                                Content="{Binding TagDisplayName, Mode=OneWay}"
                                                                IsChecked="{Binding IsTagPopupOpen, Mode=TwoWay}"
                                                                Style="{StaticResource SplitRowTagToggleStyle}"
                                                                Tag="{Binding SelectedTag.HexCode, Mode=OneWay}" />

                                                            <Popup
                                                                AllowsTransparency="True"
                                                                IsOpen="{Binding IsTagPopupOpen, Mode=TwoWay}"
                                                                Placement="Bottom"
                                                                PlacementTarget="{Binding ElementName=SplitRowTagToggleButton, Mode=OneWay}"
                                                                PopupAnimation="Fade"
                                                                StaysOpen="False"
                                                                VerticalOffset="8">
                                                                <Border
                                                                    MaxWidth="280"
                                                                    Padding="12"
                                                                    Background="{DynamicResource Brush.Background.Elevated}"
                                                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12">
                                                                    <ListBox
                                                                        ItemContainerStyle="{StaticResource SplitRowTagPopupItemStyle}"
                                                                        ItemTemplate="{StaticResource PopupTagTemplate}"
                                                                        ItemsSource="{Binding DataContext.AllSplitTags, RelativeSource={RelativeSource AncestorType=customControls:BasePopup}, Mode=OneWay}"
                                                                        SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                                                                        Style="{StaticResource SplitRowTagPopupListBoxStyle}" />
                                                                </Border>
                                                            </Popup>
                                                        </Grid>
                                                    </Grid>

                                                    <Grid Margin="0,12,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <customControls:BalloonRadioButton
                                                                CheckedBackground="{StaticResource Brush.Success}"
                                                                CornerRadius="8"
                                                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                                                GroupName="AddTransactionMode"
                                                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                                                IconSize="14"
                                                                IsChecked="{Binding IsRegularMode, Mode=TwoWay}"
                                                                IsEnabled="{Binding CanToggleRecurring, Mode=OneWay}"
                                                                ShouldShowText="True"
                                                                UncheckedIcon="{StaticResource CreditCardAlt}"
                                                                UncheckedText="Regular" />
                                                            <customControls:BalloonRadioButton
                                                                Margin="8,0,0,0"
                                                                CheckedBackground="{StaticResource Brush.Success}"
                                                                CornerRadius="8"
                                                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                                                GroupName="AddTransactionMode"
                                                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                                                IconSize="14"
                                                                IsChecked="{Binding IsPostedIoUMode, Mode=TwoWay}"
                                                                IsEnabled="{Binding CanUseIoU, Mode=OneWay}"
                                                                ShouldShowText="True"
                                                                UncheckedIcon="{StaticResource CreditCardMinusSolid}"
                                                                UncheckedText="Posted IoU" />
                                                            <customControls:BalloonCheckBox
                                                                Margin="8,0,0,0"
                                                                ButtonIcon="{StaticResource CreditCardOff}"
                                                                ButtonSize="32"
                                                                ButtonText="Exclude"
                                                                IsChecked="{Binding IsExcludedFromBudget, Mode=TwoWay}"
                                                                ShouldShowText="True" />
                                                        </StackPanel>

                                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                            <customControls:BalloonButton
                                                                ButtonIcon="{StaticResource PlusSolid}"
                                                                ButtonSize="32"
                                                                ButtonText="Add"
                                                                Click="OnAddNestedSplitRowClick"
                                                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.ConfirmSave}"
                                                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.ConfirmSave.Hovered}"
                                                                ShouldShowText="True"
                                                                Style="{StaticResource ToolbarActionBalloonButtonStyle}"
                                                                Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                            <customControls:BalloonToggle
                                                                Margin="8,0,0,0"
                                                                ButtonSize="32"
                                                                CornerRadius="8"
                                                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Default}"
                                                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Default.Hovered}"
                                                                IconSize="12"
                                                                ShouldShowText="True">
                                                                <customControls:BalloonToggle.States>
                                                                    <customControls:BalloonToggleState
                                                                        ButtonIcon="{StaticResource ArrowsOutLineVertical}"
                                                                        ButtonText="Split"
                                                                        OnChecked="{Binding SetSplitModeCommand, Mode=OneWay}" />
                                                                    <customControls:BalloonToggleState
                                                                        ButtonIcon="{StaticResource CallSplit}"
                                                                        ButtonText="Split Equally"
                                                                        OnChecked="{Binding SetSplitEquallyModeCommand, Mode=OneWay}" />
                                                                </customControls:BalloonToggle.States>
                                                            </customControls:BalloonToggle>

                                                            <customControls:BalloonButton
                                                                ButtonIcon="{StaticResource Delete}"
                                                                ButtonSize="32"
                                                                ButtonText="Delete"
                                                                Click="OnRemoveSplitRowClick"
                                                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Destructive}"
                                                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Destructive.Hovered}"
                                                                ShouldShowText="True"
                                                                Style="{StaticResource ToolbarActionBalloonButtonStyle}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border
                                                        Height="0.5"
                                                        Margin="4,12"
                                                        Background="{StaticResource Brush.Text.Muted}"
                                                        Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <ItemsControl
                                                        Margin="0,0,0,0"
                                                        ItemsSource="{Binding ChildRows, Mode=OneWay}"
                                                        Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,12">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="240" />
                                                                            <ColumnDefinition Width="160" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox
                                                                            Grid.Column="0"
                                                                            Margin="0,0,8,0"
                                                                            Style="{StaticResource RoundedTextInputStyle}"
                                                                            Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <Grid Grid.Column="1" Margin="0,0,8,0">
                                                                            <customControls:MoneyTextBox Style="{StaticResource RoundedMoneyTextInputStyle}" Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyAmountToCanonicalConverter}}" />
                                                                            <Border
                                                                                BorderBrush="{DynamicResource Brush.Danger}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="8"
                                                                                IsHitTestVisible="False"
                                                                                Visibility="{Binding IsCausingNegativeRemainder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
