                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="TransactionNameTextBox"
                        IsReadOnly="{Binding AreFieldsReadOnly, Mode=OneWay}"
