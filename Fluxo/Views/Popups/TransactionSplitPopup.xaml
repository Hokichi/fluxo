<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.TransactionSplitPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CanClone="True"
    CanDelete="True"
    CanDiscard="False"
    CanEdit="True"
    Mode="Functional"
    PopupTitle="Transaction Split"
    mc:Ignorable="d">

    <customControls:BasePopup.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        </Style>

        <Style x:Key="FieldHeaderGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldValidationHintStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PopupFieldBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="PopupTagListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="PopupTagListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="PopupOtherTagListBoxItemStyle"
            BasedOn="{StaticResource PopupTagListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <DataTemplate x:Key="PopupTagTemplate">
            <ToggleButton
                Content="{Binding Name, Mode=OneWay}"
                IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=OneWay}"
                Style="{StaticResource PopupTagItemToggleStyle}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="PopupVisibleTagsItemsPanelTemplate">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="PopupOverflowTagsItemsPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style x:Key="SplitRowTagPopupListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="MaxHeight" Value="220" />
        </Style>

        <Style x:Key="SplitRowTagPopupItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitParentAmountHighlightBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSplitMode, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding HasNegativeSplitRemainder, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="BorderThickness" Value="1" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SplitRowTagToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    x:Name="ColorDot"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Tag, Mode=OneWay}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Text="{TemplateBinding Content}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource ForegroundForBackgroundBrushConverter}">
                                            <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Mode=OneWay}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Background.Surface}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ChildTransactionItemTemplate">
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Background="{DynamicResource Brush.Background.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontFamily="{DynamicResource Bold}"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="{Binding Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontFamily="{DynamicResource Bold}"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.Danger}"
                            Text="{Binding Amount, StringFormat={}{0:#,##0}, Mode=OneWay}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        FontFamily="{DynamicResource Medium}"
                        FontSize="11"
                        Foreground="{DynamicResource Brush.Text.Muted}"
                        Text="{Binding OccurredOn, StringFormat={}{0:MMM d, yyyy}, Mode=OneWay}" />

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Orientation="Horizontal">
                        <Border
                            MaxWidth="96"
                            Padding="8,2"
                            Background="{Binding TagHexCode, Mode=OneWay}"
                            CornerRadius="8">
                            <TextBlock
                                FontFamily="{DynamicResource Bold}"
                                FontSize="10"
                                Text="{Binding TagName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Foreground>
                                    <Binding
                                        Converter="{StaticResource ForegroundForBackgroundBrushConverter}"
                                        ConverterParameter="{StaticResource Brush.Text.Primary}"
                                        Path="Background"
                                        RelativeSource="{RelativeSource AncestorType=Border}" />
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <TextBlock
                            Margin="8,2,0,0"
                            FontFamily="{DynamicResource Medium}"
                            FontSize="10"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding CategoryLabel, Mode=OneWay}" />
                    </StackPanel>
                    <Path
                        Grid.Row="2"
                        Width="13"
                        Height="13"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Data="{StaticResource CreditCardMinusSolid}"
                        Fill="{DynamicResource Brush.Info}"
                        Stretch="Uniform"
                        ToolTip="Lend"
                        Visibility="{Binding IsIoU, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SplitRowTemplate">
            <StackPanel Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Name" />
                        <TextBox
                            Grid.Row="1"
                            Style="{StaticResource RoundedTextInputStyle}"
                            Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <customControls:BalloonCheckBox
                            Grid.Row="1"
                            Grid.Column="2"
                            ButtonIcon="{StaticResource CreditCardOff}"
                            ButtonSize="32"
                            ButtonText="Exclude"
                            IsChecked="{Binding IsExcludedFromBudget, Mode=TwoWay}"
                            ShouldExpand="False"
                            ShouldShowText="True" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource SectionLabelStyle}"
                            Text="Amount"
                            Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}" />
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource SectionLabelStyle}"
                            Text="Total"
                            Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource SectionLabelStyle}"
                            Text="Remaining"
                            Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="4"
                            Style="{StaticResource SectionLabelStyle}"
                            Text="Categories"
                            Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}" />
                        <Grid
                            Grid.Row="1"
                            Grid.Column="0"
                            Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}">
                            <customControls:MoneyTextBox Style="{StaticResource RoundedMoneyTextInputStyle}" Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyAmountToCanonicalConverter}}" />
                            <Border
                                BorderBrush="{DynamicResource Brush.Danger}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsCausingNegativeRemainder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                        <Grid
                            Grid.Row="1"
                            Grid.Column="0"
                            Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <customControls:MoneyTextBox Style="{StaticResource RoundedMoneyTextInputStyle}" Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyAmountToCanonicalConverter}}" />
                            <Border
                                BorderBrush="{DynamicResource Brush.Danger}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsCausingNegativeRemainder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                        <customControls:MoneyTextBox
                            Grid.Row="1"
                            Grid.Column="2"
                            IsReadOnly="True"
                            Style="{StaticResource RoundedMoneyTextInputStyle}"
                            Text="{Binding RemainingAmount, Mode=OneWay, Converter={StaticResource MoneyAmountToCanonicalConverter}}"
                            Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="4"
                            IsEnabled="{Binding CanSelectCategory, Mode=OneWay}"
                            Orientation="Horizontal"
                            Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}">
                            <customControls:BalloonRadioButton
                                ButtonIcon="{StaticResource Home}"
                                CheckedBackground="{StaticResource Brush.Mint}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                GroupName="SplitCategory"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                IconSize="12"
                                IsChecked="{Binding IsNeedsCategory, Mode=TwoWay}"
                                ShouldShowText="True"
                                UncheckedText="Needs" />
                            <customControls:BalloonRadioButton
                                Margin="8,0,0,0"
                                ButtonIcon="{StaticResource ShoppingBag}"
                                CheckedBackground="{StaticResource Brush.Mint}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                GroupName="SplitCategory"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                IconSize="12"
                                IsChecked="{Binding IsWantsCategory, Mode=TwoWay}"
                                ShouldShowText="True"
                                UncheckedText="Wants" />
                            <customControls:BalloonRadioButton
                                Margin="8,0,0,0"
                                ButtonIcon="{StaticResource TrendingUp}"
                                CheckedBackground="{StaticResource Brush.Mint}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                                GroupName="SplitCategory"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                                IconSize="12"
                                IsChecked="{Binding IsInvestCategory, Mode=TwoWay}"
                                ShouldShowText="True"
                                UncheckedText="Invest" />
                        </StackPanel>
                    </Grid>
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Visibility="{Binding ShowLeafTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Tags" />
                        <ListBox
                            ItemContainerStyle="{StaticResource PopupTagListBoxItemStyle}"
                            ItemTemplate="{StaticResource PopupTagTemplate}"
                            ItemsPanel="{StaticResource PopupVisibleTagsItemsPanelTemplate}"
                            ItemsSource="{Binding DataContext.AllSplitTags, RelativeSource={RelativeSource AncestorType=customControls:BasePopup}, Mode=OneWay}"
                            SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                            Style="{StaticResource PopupTagListBoxStyle}" />
                    </StackPanel>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <customControls:BalloonRadioButton
                                CheckedBackground="{StaticResource Brush.Success}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                GroupName="AddTransactionMode"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                IconSize="14"
                                IsChecked="{Binding IsRegularMode, Mode=TwoWay}"
                                IsEnabled="{Binding CanToggleRecurring, Mode=OneWay}"
                                ShouldShowText="True"
                                UncheckedIcon="{StaticResource CreditCardAlt}"
                                UncheckedText="Regular" />
                            <customControls:BalloonRadioButton
                                Margin="8,0,0,0"
                                CheckedBackground="{StaticResource Brush.Success}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                GroupName="AddTransactionMode"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                IconSize="14"
                                IsChecked="{Binding IsPostedIoUMode, Mode=TwoWay}"
                                IsEnabled="{Binding CanUseIoU, Mode=OneWay}"
                                ShouldShowText="True"
                                UncheckedIcon="{StaticResource CreditCardMinusSolid}"
                                UncheckedText="Posted IoU" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <customControls:BalloonButton
                                ButtonIcon="{StaticResource PlusSolid}"
                                ButtonSize="32"
                                ButtonText="Add"
                                Click="OnAddNestedSplitRowClick"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.ConfirmSave}"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.ConfirmSave.Hovered}"
                                ShouldShowText="False"
                                Style="{StaticResource ToolbarActionBalloonButtonStyle}"
                                Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <customControls:BalloonCheckBox
                                Margin="8,0,0,0"
                                ButtonIcon="{StaticResource ArrowsOutLineVertical}"
                                ButtonSize="32"
                                ButtonText="Split"
                                CheckedBackground="{StaticResource Brush.BalloonButton.Background.ConfirmSave}"
                                CornerRadius="8"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Default}"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Default.Hovered}"
                                IconSize="12"
                                IsChecked="{Binding IsSplit, Mode=TwoWay}"
                                ShouldShowText="False" />
                            <customControls:BalloonButton
                                Margin="8,0,0,0"
                                ButtonIcon="{StaticResource Delete}"
                                ButtonSize="32"
                                ButtonText="Delete"
                                Click="OnRemoveSplitRowClick"
                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Destructive}"
                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Destructive.Hovered}"
                                ShouldShowText="False"
                                Style="{StaticResource ToolbarActionBalloonButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border
                    Height="0.5"
                    Margin="4,12"
                    Background="{StaticResource Brush.Text.Muted}"
                    Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ItemsControl
                    ItemTemplate="{DynamicResource NestedSplitRowTemplate}"
                    ItemsSource="{Binding ChildRows, Mode=OneWay}"
                    Visibility="{Binding IsSplit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NestedSplitRowTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Name" />
                    <TextBox
                        Grid.Row="1"
                        Style="{StaticResource RoundedTextInputStyle}"
                        Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <customControls:BalloonCheckBox
                        Grid.Row="1"
                        Grid.Column="2"
                        ButtonIcon="{StaticResource CreditCardOff}"
                        ButtonSize="32"
                        ButtonText="Exclude"
                        IsChecked="{Binding IsExcludedFromBudget, Mode=TwoWay}"
                        ShouldExpand="False"
                        ShouldShowText="True" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource SectionLabelStyle}"
                        Text="Amount" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource SectionLabelStyle}"
                        Text="Categories" />
                    <Grid Grid.Row="1" Grid.Column="0">
                        <customControls:MoneyTextBox Style="{StaticResource RoundedMoneyTextInputStyle}" Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MoneyAmountToCanonicalConverter}}" />
                        <Border
                            BorderBrush="{DynamicResource Brush.Danger}"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsCausingNegativeRemainder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="2"
                        IsEnabled="{Binding CanSelectCategory, Mode=OneWay}"
                        Orientation="Horizontal">
                        <customControls:BalloonRadioButton
                            ButtonIcon="{StaticResource Home}"
                            CheckedBackground="{StaticResource Brush.Mint}"
                            CornerRadius="8"
                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                            GroupName="NestedSplitCategory"
                            HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                            IconSize="12"
                            IsChecked="{Binding IsNeedsCategory, Mode=TwoWay}"
                            ShouldShowText="True"
                            UncheckedText="Needs" />
                        <customControls:BalloonRadioButton
                            Margin="8,0,0,0"
                            ButtonIcon="{StaticResource ShoppingBag}"
                            CheckedBackground="{StaticResource Brush.Mint}"
                            CornerRadius="8"
                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                            GroupName="NestedSplitCategory"
                            HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                            IconSize="12"
                            IsChecked="{Binding IsWantsCategory, Mode=TwoWay}"
                            ShouldShowText="True"
                            UncheckedText="Wants" />
                        <customControls:BalloonRadioButton
                            Margin="8,0,0,0"
                            ButtonIcon="{StaticResource TrendingUp}"
                            CheckedBackground="{StaticResource Brush.Mint}"
                            CornerRadius="8"
                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Surface}"
                            GroupName="NestedSplitCategory"
                            HoveredBackground="{StaticResource Brush.BalloonButton.Background.Surface.Hovered}"
                            IconSize="12"
                            IsChecked="{Binding IsInvestCategory, Mode=TwoWay}"
                            ShouldShowText="True"
                            UncheckedText="Invest" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Tags" />
                    <ListBox
                        ItemContainerStyle="{StaticResource PopupTagListBoxItemStyle}"
                        ItemTemplate="{StaticResource PopupTagTemplate}"
                        ItemsPanel="{StaticResource PopupVisibleTagsItemsPanelTemplate}"
                        ItemsSource="{Binding DataContext.AllSplitTags, RelativeSource={RelativeSource AncestorType=customControls:BasePopup}, Mode=OneWay}"
                        SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                        Style="{StaticResource PopupTagListBoxStyle}" />
                </StackPanel>
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <customControls:BalloonRadioButton
                            CheckedBackground="{StaticResource Brush.Success}"
                            CornerRadius="8"
                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                            GroupName="AddTransactionMode"
                            HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                            IconSize="14"
                            IsChecked="{Binding IsRegularMode, Mode=TwoWay}"
                            IsEnabled="{Binding CanToggleRecurring, Mode=OneWay}"
                            ShouldShowText="True"
                            UncheckedIcon="{StaticResource CreditCardAlt}"
                            UncheckedText="Regular" />
                        <customControls:BalloonRadioButton
                            Margin="8,0,0,0"
                            CheckedBackground="{StaticResource Brush.Success}"
                            CornerRadius="8"
                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                            GroupName="AddTransactionMode"
                            HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                            IconSize="14"
                            IsChecked="{Binding IsPostedIoUMode, Mode=TwoWay}"
                            IsEnabled="{Binding CanUseIoU, Mode=OneWay}"
