                                                                        <StackPanel
                                                                            Grid.Column="2"
                                                                            Margin="0,0,8,0"
                                                                            IsEnabled="{Binding CanSelectCategory, Mode=OneWay}"
                                                                            Orientation="Horizontal">
                                                                            <customControls:BalloonRadioButton
                                                                                GroupName="NestedSplitCategory"
                                                                                IsChecked="{Binding IsNeedsCategory, Mode=TwoWay}"
                                                                                ShouldShowText="True"
                                                                                UncheckedText="Needs" />
                                                                            <customControls:BalloonRadioButton
                                                                                GroupName="NestedSplitCategory"
                                                                                IsChecked="{Binding IsWantsCategory, Mode=TwoWay}"
                                                                                ShouldShowText="True"
                                                                                UncheckedText="Wants" />
                                                                            <customControls:BalloonRadioButton
                                                                                GroupName="NestedSplitCategory"
                                                                                IsChecked="{Binding IsInvestCategory, Mode=TwoWay}"
                                                                                ShouldShowText="True"
                                                                                UncheckedText="Invest" />
                                                                        </StackPanel>
                                                                        <Grid Grid.Column="3" Margin="0,0,8,0">
                                                                            <ToggleButton
                                                                                x:Name="NestedSplitRowTagToggleButton"
                                                                                Content="{Binding TagDisplayName, Mode=OneWay}"
                                                                                IsChecked="{Binding IsTagPopupOpen, Mode=TwoWay}"
                                                                                Style="{StaticResource SplitRowTagToggleStyle}"
                                                                                Tag="{Binding SelectedTag.HexCode, Mode=OneWay}" />
                                                                            <Popup
                                                                                AllowsTransparency="True"
                                                                                IsOpen="{Binding IsTagPopupOpen, Mode=TwoWay}"
                                                                                Placement="Bottom"
                                                                                PlacementTarget="{Binding ElementName=NestedSplitRowTagToggleButton, Mode=OneWay}"
                                                                                PopupAnimation="Fade"
                                                                                StaysOpen="False"
                                                                                VerticalOffset="8">
                                                                                <Border
                                                                                    MaxWidth="280"
                                                                                    Padding="12"
                                                                                    Background="{DynamicResource Brush.Background.Elevated}"
                                                                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="12">
                                                                                    <ListBox
                                                                                        ItemContainerStyle="{StaticResource SplitRowTagPopupItemStyle}"
                                                                                        ItemTemplate="{StaticResource PopupTagTemplate}"
                                                                                        ItemsSource="{Binding DataContext.AllSplitTags, RelativeSource={RelativeSource AncestorType=customControls:BasePopup}, Mode=OneWay}"
                                                                                        SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                                                                                        Style="{StaticResource SplitRowTagPopupListBoxStyle}" />
                                                                                </Border>
                                                                            </Popup>
                                                                        </Grid>
                                                                    </Grid>
                                                                    <Grid Margin="0,12,0,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <customControls:BalloonRadioButton
                                                                                CheckedBackground="{StaticResource Brush.Success}"
                                                                                CornerRadius="8"
                                                                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                                                                GroupName="AddTransactionMode"
                                                                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                                                                IconSize="14"
                                                                                IsChecked="{Binding IsRegularMode, Mode=TwoWay}"
                                                                                IsEnabled="{Binding CanToggleRecurring, Mode=OneWay}"
                                                                                ShouldShowText="True"
                                                                                UncheckedIcon="{StaticResource CreditCardAlt}"
                                                                                UncheckedText="Regular" />
                                                                            <customControls:BalloonRadioButton
                                                                                Margin="8,0,0,0"
                                                                                CheckedBackground="{StaticResource Brush.Success}"
                                                                                CornerRadius="8"
                                                                                DefaultBackground="{StaticResource Brush.BalloonButton.Background.Neutral}"
                                                                                GroupName="AddTransactionMode"
                                                                                HoveredBackground="{StaticResource Brush.BalloonButton.Background.Neutral.Hovered}"
                                                                                IconSize="14"
                                                                                IsChecked="{Binding IsPostedIoUMode, Mode=TwoWay}"
                                                                                IsEnabled="{Binding CanUseIoU, Mode=OneWay}"
                                                                                ShouldShowText="True"
                                                                                UncheckedIcon="{StaticResource CreditCardMinusSolid}"
                                                                                UncheckedText="Posted IoU" />
                                                                            <customControls:BalloonCheckBox
                                                                                Margin="8,0,0,0"
                                                                                ButtonIcon="{StaticResource CreditCardOff}"
                                                                                ButtonSize="32"
                                                                                ButtonText="Exclude"
                                                                                IsChecked="{Binding IsExcludedFromBudget, Mode=TwoWay}"
                                                                                ShouldShowText="True" />
                                                                        </StackPanel>
                                                                        <customControls:BalloonButton
                                                                            HorizontalAlignment="Right"
                                                                            ButtonIcon="{StaticResource Delete}"
                                                                            ButtonSize="32"
                                                                            ButtonText="Delete"
                                                                            Click="OnRemoveNestedSplitRowClick"
                                                                            DefaultBackground="{StaticResource Brush.BalloonButton.Background.Destructive}"
                                                                            HoveredBackground="{StaticResource Brush.BalloonButton.Background.Destructive.Hovered}"
                                                                            ShouldShowText="True"
                                                                            Style="{StaticResource ToolbarActionBalloonButtonStyle}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemTemplate="{StaticResource SplitRowTemplate}" ItemsSource="{Binding SplitRows, Mode=OneWay}" />
                            </StackPanel>
                        </customControls:FadingScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel
                x:Name="NormalTransactionNotePanel"
                Grid.Row="2"
                Margin="0,16,0,0"
                Visibility="{Binding ShowNormalTransactionFields, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Note" />
                <Border Style="{StaticResource PopupFieldBorderStyle}">
                    <RichTextBox
                        x:Name="NoteRichTextBox"
                        MinHeight="120"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="{DynamicResource Brush.Text.Primary}"
                        FontFamily="{DynamicResource Regular}"
                        FontSize="13"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        IsReadOnly="{Binding AreFieldsReadOnly, Mode=OneWay}"
                        TextChanged="OnNoteTextChanged"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
            </StackPanel>

            <Border
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="Transparent"
                Visibility="{Binding CanEditFields, Converter={StaticResource BoolToVisibilityInvertedConverter}, Mode=OneWay}" />

            <Border
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="2"
                Margin="16,0,0,0"
                Padding="12"
                Background="{DynamicResource Brush.Background.Elevated}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ShowChildTransactions, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <StackPanel>
                    <TextBlock
                        FontFamily="{DynamicResource Bold}"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="Sub-transactions" />
                    <ScrollViewer
                        Width="260"
                        MaxHeight="520"
                        Margin="0,12,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemTemplate="{StaticResource ChildTransactionItemTemplate}" ItemsSource="{Binding ChildTransactions, Mode=OneWay}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</customControls:BasePopup>

