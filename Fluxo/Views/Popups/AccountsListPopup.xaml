<customControls:BasePopup
    x:Class="Fluxo.Views.Popups.AccountsListPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Fluxo.Resources.Components;assembly=Fluxo.Resources"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    PopupTitle="Accounts">

<customControls:BasePopup.Resources>
<Style x:Key="SourceButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="RootBorder"
                        Padding="16"
                        Background="{DynamicResource Brush.Background.Elevated}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <Style x:Key="AccentStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Account.Checking}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AccountType}" Value="Credit">
                    <Setter Property="Background" Value="{DynamicResource Brush.Account.Credit}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccountType}" Value="Saving">
                    <Setter Property="Background" Value="{DynamicResource Brush.Account.Saving}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccountType}" Value="Cash">
                    <Setter Property="Background" Value="{DynamicResource Brush.Account.Cash}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BankIconStyle" BasedOn="{StaticResource BaseIconStyle}" TargetType="components:Icon">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AccountType}" Value="Checking">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccountType}" Value="Cash">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CreditIconStyle" BasedOn="{StaticResource BaseIconStyle}" TargetType="components:Icon">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AccountType}" Value="Credit">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccountCardStateGridStyle" BasedOn="{StaticResource BaseGridStyle}" TargetType="Grid">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SavingAccountIconStyle" BasedOn="{StaticResource BaseIconStyle}" TargetType="components:Icon">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AccountType}" Value="Saving">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DisabledAccountBadgeStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding PinnedOnUI}" Value="False" />
                        <Condition Binding="{Binding IsDisabled}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="AccountsListItemTemplate">
            <Button
                Margin="12,12,12,0"
                Click="OnSourceClick"
                Style="{StaticResource SourceButtonStyle}">
                <Grid Style="{StaticResource AccountCardStateGridStyle}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="AccentBorder"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        CornerRadius="18"
                        Style="{StaticResource AccentStyle}">
                        <Grid>
                            <components:Icon
                                Margin="10"
                                Path="{StaticResource Bank}"
                                Style="{StaticResource BankIconStyle}"
                                Color="{Binding Background, ElementName=AccentBorder, Converter={StaticResource BackgroundToForegroundConverter}}" />
                            <components:Icon
                                Margin="10"
                                Path="{StaticResource CreditCardAlt}"
                                Style="{StaticResource CreditIconStyle}"
                                Color="{Binding Background, ElementName=AccentBorder, Converter={StaticResource BackgroundToForegroundConverter}}" />
                            <components:Icon
                                Margin="10"
                                Path="{StaticResource PiggyBank}"
                                Color="{Binding Background, ElementName=AccentBorder, Converter={StaticResource BackgroundToForegroundConverter}}" Style="{StaticResource SavingAccountIconStyle}">

                            </components:Icon>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontFamily="{StaticResource Bold}"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                Text="{Binding Name}" />
                            <Border
                                Width="12"
                                Height="12"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <components:Icon Path="{StaticResource LightningSlashFill}" Color="{DynamicResource Brush.Danger}" />
                            </Border>
                            <Border
                                Width="12"
                                Height="12"
                                Margin="8,0,0,0" Style="{StaticResource DisabledAccountBadgeStyle}">

                                <components:Icon Path="{StaticResource Unpin}" Color="{DynamicResource Brush.Warning}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontFamily="{StaticResource Medium}"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            Text="{Binding TypeDisplayName}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="{StaticResource Bold}"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            ToolTip="{Binding PrimaryAmount, Mode=OneWay, Converter={StaticResource MoneyFullDisplayConverter}}">
                            <Run Text="{Binding PrimaryAmount, Mode=OneWay, Converter={StaticResource NumberWithCommasConverter}}" />
                        </TextBlock>
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right"
                            FontFamily="{StaticResource Medium}"
                            FontSize="10"
                            Foreground="{DynamicResource Brush.Text.Muted}"
                            Text="{Binding PrimaryAmountLabel}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

</customControls:BasePopup.Resources>

    <Grid
        Width="400"
        Height="300"
        Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <customControls:BalloonButton
            x:Name="AddNewSourceButton"
            Grid.Row="2"
            HorizontalAlignment="Right"
            ButtonIcon="{StaticResource PlusSolid}"
            ButtonText="Add New Account"
            Click="OnAddNewSourceClick"
            CornerRadius="8"
            DefaultBackground="{DynamicResource Brush.BalloonButton.Background.Default}"
            HoveredBackground="{DynamicResource Brush.BalloonButton.Background.Default.Hovered}"
            IconSize="10"
            ShouldExpand="True" />

        <Border
            Grid.Row="0"
            Padding="0,0,0,12"
            Background="{DynamicResource Brush.Background.Surface}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="18">
            <customControls:FadingScrollViewer Margin="0" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="SourcesList" ItemTemplate="{StaticResource AccountsListItemTemplate}" />
            </customControls:FadingScrollViewer>
        </Border>
    </Grid>
</customControls:BasePopup>




