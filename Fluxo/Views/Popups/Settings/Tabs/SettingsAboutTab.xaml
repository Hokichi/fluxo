<UserControl
    x:Class="Fluxo.Views.Popups.Settings.Tabs.SettingsAboutTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreEnums="clr-namespace:Fluxo.Core.Enums;assembly=Fluxo.Core"
    xmlns:customControls="clr-namespace:Fluxo.Resources.CustomControls;assembly=Fluxo.Resources"
    AutomationProperties.AutomationId="Settings.Configuration.Root">

    <UserControl.Resources>
        <Style x:Key="AboutMutedAccentTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Mint.Muted}" />
        </Style>

        <Style x:Key="AboutSecondaryHeadingTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <Style x:Key="AboutInlineStackStyle" BasedOn="{StaticResource BaseStackPanelStyle}" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>

        <Style x:Key="AboutMetadataStackStyle" BasedOn="{StaticResource BaseStackPanelStyle}" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>

        <Style x:Key="AboutDescriptionTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Medium}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="AboutHeadingTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource AboutHeadingTextStyle}"
            FontSize="16"
            Text="Configuration" />
        <TextBlock
            Margin="0,8,0,16"
            FontFamily="{StaticResource Medium}"
            FontSize="11"
            Foreground="{DynamicResource Brush.Text.Secondary}"
            Text="Configure how the app behaves" />

        <Border Style="{StaticResource RowCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource AboutHeadingTextStyle}"
                        Text="Run with Windows" />
                    <StackPanel Style="{StaticResource AboutMetadataStackStyle}">
                        <TextBlock Style="{StaticResource AboutDescriptionTextStyle}">
                            <Run Text="Start " />
                        </TextBlock>
                        <TextBlock Style="{StaticResource AboutSecondaryHeadingTextStyle}"
                            Text="flux" />
                        <TextBlock Style="{StaticResource AboutMutedAccentTextStyle}"
                            Text="o" />
                        <TextBlock Style="{StaticResource AboutDescriptionTextStyle}">
                            <Run Text=" in the system tray when Windows signs in." />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <ToggleButton
                    AutomationProperties.AutomationId="Settings.Configuration.RunWithWindows"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding ShouldRunAtStartup, Mode=TwoWay}"
                    Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Margin="0,6,0,0" Style="{StaticResource RowCardStyle}">
            <Grid>
                <StackPanel Style="{StaticResource AboutInlineStackStyle}">
                    <TextBlock Style="{StaticResource AboutHeadingTextStyle}"
                        Text="When closing " />
                    <TextBlock Style="{StaticResource AboutHeadingTextStyle}"
                        Text="flux" />
                    <TextBlock
                        FontFamily="{StaticResource Bold}"
                        Foreground="{DynamicResource Brush.Mint}"
                        Text="o" />
                </StackPanel>
                <customControls:SegmentedToggleGroup AutomationProperties.AutomationId="Settings.Configuration.CloseBehavior" Width="252" HorizontalAlignment="Right">
                    <customControls:SegmentedToggleOption
                        AutomationProperties.AutomationId="Settings.Configuration.MinimizeToTray"
                        Command="{Binding SetCloseBehaviorCommand}"
                        CommandParameter="{x:Static coreEnums:AppCloseBehavior.MinimizeToTray}"
                        Content="Minimize to tray"
                        IsSelected="{Binding IsMinimizeToTrayCloseBehaviorSelected, Mode=OneWay}"
                        SelectOnClick="False" />
                    <customControls:SegmentedToggleOption
                        AutomationProperties.AutomationId="Settings.Configuration.Exit"
                        Command="{Binding SetCloseBehaviorCommand}"
                        CommandParameter="{x:Static coreEnums:AppCloseBehavior.Exit}"
                        Content="Exit"
                        IsSelected="{Binding IsExitCloseBehaviorSelected, Mode=OneWay}"
                        SelectOnClick="False" />
                </customControls:SegmentedToggleGroup>
            </Grid>
        </Border>

        <Border Margin="0,12,0,0" Style="{StaticResource RowCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource AboutHeadingTextStyle}"
                        Text="Current Version" />
                    <StackPanel Style="{StaticResource AboutMetadataStackStyle}">
                        <TextBlock Style="{StaticResource AboutDescriptionTextStyle}"
                            Text="Currently installed version of " />
                        <TextBlock Style="{StaticResource AboutSecondaryHeadingTextStyle}"
                            Text="flux" />
                        <TextBlock Style="{StaticResource AboutMutedAccentTextStyle}"
                            Text="o." />
                    </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource AboutInlineStackStyle}"
                    Grid.Column="1">
                    <TextBlock Style="{StaticResource AboutHeadingTextStyle}"
                        VerticalAlignment="Center"
                        Text="{Binding CurrentVersion}" />
                    <Button
                        x:Name="CheckForUpdatesButton"
                        AutomationProperties.AutomationId="Settings.Configuration.CheckUpdates"
                        MinWidth="128"
                        Margin="12,0,0,0"
                        Click="OnCheckForUpdatesClick"
                        Content="Check for updates"
                        Style="{StaticResource PopupTextButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                AutomationProperties.AutomationId="Settings.Configuration.Reset"
                Click="OnResetAllSettingsClick"
                Content="Reset All Settings"
                Style="{StaticResource PopupTextButtonStyle}" />
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="Settings.Configuration.DeleteAllData"
                Click="OnDeleteAllDataClick"
                Content="Delete All Data"
                Foreground="{DynamicResource Brush.Danger}"
                Style="{StaticResource PopupTextButtonStyle}" />
        </Grid>
    </StackPanel>
</UserControl>
